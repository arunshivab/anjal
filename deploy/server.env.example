# From v1.0.0-rc.7 the non-secret settings below are imported into the
# database at the first start and read from there afterwards; change them
# through the admin API (DEPLOY.md section 13e). Secrets stay in this file.
# /etc/anjal/server.env - environment for anjal-server.service
# root:anjal 640. Restart the service after editing: systemctl restart anjal-server
# Every ANJAL_* variable is documented in README.md; these are the ones a
# single-VM production deployment needs.

# ---- identity ----
ANJAL_HOSTNAME=mail.anjal.co.in
ANJAL_BIND=0.0.0.0
ANJAL_PORT=25
ANJAL_SUBMISSION_PORT=587
# Implicit-TLS submission (RFC 8314) for mail clients that prefer 465.
ANJAL_SUBMISSION_TLS_PORT=465
ANJAL_INBOUND_AUTH_ENFORCE=dmarc-reject

# ---- storage ----
ANJAL_POSTGRES=Host=127.0.0.1;Port=5432;Database=anjal;Username=anjal;Password=CHANGE-ME
ANJAL_MAILDIR_ROOT=/var/mail/anjal

# ---- local domains (tenant domains from the API are added automatically) ----
ANJAL_LOCAL_DOMAINS=anjal.co.in

# ---- outbound ----
ANJAL_OUTBOUND_MODE=direct
ANJAL_TLS_DEFAULT_MODE=opportunistic
# Mail is never sent unencrypted (v1.0.0-rc.7): a message that cannot be
# encrypted is held, retried and finally returned to its sender. true brings
# back plaintext fallback - for test rigs only, never in production.
#ANJAL_TLS_ALLOW_PLAINTEXT=false
ANJAL_DKIM_MODE=required
# DKIM private keys are stored via POST /api/dkim-keys (DEPLOY.md section 8).

# ---- admin API (bind to loopback; reach it with ssh -L or curl on the box) ----
ANJAL_API_BIND=127.0.0.1
ANJAL_API_PORT=8025
# 24 characters or more, random. The server refuses to start with a short
# token, too little variety, or an obvious placeholder. Generate it ON THIS
# SERVER with: openssl rand -hex 24   (48 characters, 0-9 and a-f only, so a
# handwritten copy has no O/0 or l/1 to misread). DEPLOY.md section 4.
ANJAL_API_TOKEN=
# While replacing the token, put the OLD one here so callers keep working;
# remove it once they all use the new one, then restart (SEC-R3).
ANJAL_API_TOKEN_PREVIOUS=
# The API refuses to start without a token, and refuses a non-loopback bind.

# ---- secrets at rest ----
# Seals DKIM private keys in the database (AES-256-GCM). Generate once, ON
# THIS SERVER, with
#   openssl rand -base64 32
# and write it on the three handwritten custody forms (ANJAL-SEC-03), proving
# each copy as DEPLOY.md section 4 describes. It is the only secret that
# cannot be reset: without it, encrypted DKIM keys cannot be read and must be
# regenerated and republished in DNS.
ANJAL_KEK=CHANGE-ME-openssl-rand-base64-32

# ---- TLS via ACME (the webmail hosts renewal; the server only reads the certificate) ----
ANJAL_ACME_DOMAINS=mail.anjal.co.in
ANJAL_ACME_EMAIL=arun@anjal.co.in
ANJAL_ACME_DIR=/var/lib/anjal/acme
ANJAL_ACME_HOST=false
# ANJAL_ACME_STAGING=true   # first run only - see DEPLOY.md section 7
ANJAL_TLS_REQUIRE=false
# Outbound: opportunistic TLS encrypts without validating (RFC 7435); domains
# with a "required" TLS policy are validated, with revocation checking.
ANJAL_TLS_REVOCATION=online

# ---- anti-spam and limits (defaults shown) ----
ANJAL_SPAM_ACTION=junk
ANJAL_SPAM_DNS=true
ANJAL_GREYLIST=true
# Greylisting (v1.0.0-rc.5, decision 2B). A sender whose connecting IP passes
# SPF for its own domain is not delayed; others wait ANJAL_GREYLIST_DELAY_SECONDS
# once, then are remembered for ANJAL_GREYLIST_REMEMBER_DAYS after their last
# message, in ANJAL_GREYLIST_STATE so restarts forget nobody ("none" keeps them
# in memory only; losing the file only means senders are delayed once more).
ANJAL_GREYLIST_DELAY_SECONDS=300
ANJAL_GREYLIST_REMEMBER_DAYS=35
ANJAL_GREYLIST_SKIP_SPF_PASS=true
ANJAL_GREYLIST_STATE=/var/lib/anjal/greylist.tsv
ANJAL_RATE_CONN_PER_MIN=60
ANJAL_RATE_MSG_PER_HOUR=200
ANJAL_RATE_USER_MSG_PER_HOUR=100

# ---- connection limits (defaults shown) ----
ANJAL_SMTP_IDLE_TIMEOUT_SECONDS=300
ANJAL_SMTP_MAX_SESSION_MINUTES=15
ANJAL_SMTP_MAX_CONNECTIONS=200
ANJAL_SMTP_MAX_CONNECTIONS_PER_IP=10
ANJAL_SMTP_AUTH_FAILURES_PER_IP=10

# ---- webhooks (SIGMA / Lipi) ----
# https to public addresses only by default. Uncomment for a receiver on the
# same host or private network.
# ANJAL_WEBHOOK_ALLOW_PRIVATE=true
# ANJAL_WEBHOOK_ALLOW_HTTP=true

# ---- backup (read by backup.sh) ----
ANJAL_BACKUP_REMOTE=b2crypt:
ANJAL_BACKUP_KEEP_DUMPS=30

# Evidence store (v1.0.0-rc.8, ANJAL-DES-01): the original of every message,
# as received or sent, with a daily manifest chain. Default shown.
#ANJAL_EVIDENCE_ROOT=/var/lib/anjal/evidence

# Leaked passwords (rc.15, item 35). Every new password is checked twice:
# online against Have I Been Pwned's full, current list by k-anonymity (only the
# first 5 of the 40 characters of the password's SHA-1 are sent; the match is
# made here; if the service cannot be reached the password is judged without
# it), and against a list downloaded to this server - passwords seen in at least
# ANJAL_PWNED_MIN_COUNT leaks (3: about 1.1 billion, about 5.8 GB) - which the
# server downloads from api.pwnedpasswords.com (about an hour) and refreshes
# every ANJAL_PWNED_REFRESH_DAYS. A download needs about 8 GB free while the new
# file is built beside the old. ANJAL_PWNED_MODE: both, download (nothing sent
# at password time), online (no list kept) or off. ANJAL_PWNED_SOURCE=off never
# downloads (a list copied in with "Anjal.Server --pwned-build --from-file ..."
# is still used). Defaults shown.
#ANJAL_PWNED_MODE=both
#ANJAL_PWNED_ONLINE_MIN_COUNT=1
#ANJAL_PWNED_FILE=/var/lib/anjal/pwned-passwords.bin
#ANJAL_PWNED_SOURCE=api
#ANJAL_PWNED_REFRESH_DAYS=182
#ANJAL_PWNED_MIN_COUNT=3

# postmaster@ and abuse@ this server's own name, and bare <postmaster> (RFC 5321 4.5.1)
# are delivered here (v1.0.0-rc.8). Unset: postmaster@ the server's parent domain.
#ANJAL_POSTMASTER=arun@anjal.co.in

# Time zone for dates Anjal writes into messages (v1.0.0-rc.8): an IANA name,
# written with its true offset. Default shown; unknown names fall back to UTC.
#ANJAL_TIMEZONE=Asia/Kolkata
