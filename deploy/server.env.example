# /etc/anjal/server.env - environment for anjal-server.service
# root:anjal 640. Restart the service after editing: systemctl restart anjal-server
# Every ANJAL_* variable is documented in README.md; these are the ones a
# single-VM production deployment needs.

# ---- identity ----
ANJAL_HOSTNAME=mail.anjal.co.in
ANJAL_BIND=0.0.0.0
ANJAL_PORT=25
ANJAL_SUBMISSION_PORT=587
ANJAL_INBOUND_AUTH_ENFORCE=dmarc-reject

# ---- storage ----
ANJAL_POSTGRES=Host=127.0.0.1;Port=5432;Database=anjal;Username=anjal;Password=CHANGE-ME
ANJAL_MAILDIR_ROOT=/var/mail/anjal

# ---- local domains (tenant domains from the API are added automatically) ----
ANJAL_LOCAL_DOMAINS=anjal.co.in

# ---- outbound ----
ANJAL_OUTBOUND_MODE=direct
ANJAL_TLS_DEFAULT_MODE=opportunistic
ANJAL_DKIM_MODE=required
# DKIM private keys are stored via POST /api/dkim-keys (DEPLOY.md section 8).

# ---- admin API (bind to loopback; reach it with ssh -L or curl on the box) ----
ANJAL_API_BIND=127.0.0.1
ANJAL_API_PORT=8025
ANJAL_API_TOKEN=CHANGE-ME-long-random-string

# ---- TLS via ACME (the webmail hosts renewal; the server only reads the certificate) ----
ANJAL_ACME_DOMAINS=mail.anjal.co.in
ANJAL_ACME_EMAIL=arun@anjal.co.in
ANJAL_ACME_DIR=/var/lib/anjal/acme
ANJAL_ACME_HOST=false
# ANJAL_ACME_STAGING=true   # first run only - see DEPLOY.md section 7
ANJAL_TLS_REQUIRE=false

# ---- anti-spam and limits (defaults shown) ----
ANJAL_SPAM_ACTION=junk
ANJAL_SPAM_DNS=true
ANJAL_GREYLIST=true
ANJAL_RATE_CONN_PER_MIN=60
ANJAL_RATE_MSG_PER_HOUR=200
ANJAL_RATE_USER_MSG_PER_HOUR=100

# ---- backup (read by backup.sh) ----
ANJAL_BACKUP_REMOTE=b2crypt:
ANJAL_BACKUP_KEEP_DUMPS=30
