# /etc/anjal/webmail.env - environment for anjal-webmail.service
# root:anjal 640. Restart after editing: systemctl restart anjal-webmail
# Contains only what the webmail needs: no API token, no DKIM, no relay credentials.

ANJAL_HOSTNAME=mail.anjal.co.in
ANJAL_WEBMAIL_BIND=0.0.0.0
ANJAL_WEBMAIL_PORT=80
ANJAL_WEBMAIL_HTTPS_PORT=443

ANJAL_POSTGRES=Host=127.0.0.1;Port=5432;Database=anjal;Username=anjal;Password=CHANGE-ME
ANJAL_MAILDIR_ROOT=/var/mail/anjal

# ACME: this process obtains and renews the certificate.
ANJAL_ACME_DOMAINS=mail.anjal.co.in
ANJAL_ACME_EMAIL=arun@anjal.co.in
ANJAL_ACME_DIR=/var/lib/anjal/acme
ANJAL_ACME_HOST=true
ANJAL_ACME_KEY=ecdsa-p256
ANJAL_ACME_RENEW_DAYS=30
# ANJAL_ACME_STAGING=true   # first run only - see DEPLOY.md section 7
