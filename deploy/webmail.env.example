# From v1.0.0-rc.7 the non-secret settings below are imported into the
# database at the first start and read from there afterwards; change them
# through the admin API (DEPLOY.md section 13e). Secrets stay in this file.
# /etc/anjal/webmail.env - environment for anjal-webmail.service
# root:anjal 640. Restart after editing: systemctl restart anjal-webmail
# Contains only what the webmail needs: no API token, no DKIM, no relay credentials.

ANJAL_HOSTNAME=mail.anjal.co.in
ANJAL_WEBMAIL_BIND=0.0.0.0
ANJAL_WEBMAIL_PORT=80
ANJAL_WEBMAIL_HTTPS_PORT=443
# HTTP/3 on the HTTPS port when libmsquic is installed (DEPLOY.md section 1d);
# false serves HTTP/1.1 and HTTP/2 only.
#ANJAL_WEBMAIL_HTTP3=true

ANJAL_POSTGRES=Host=127.0.0.1;Port=5432;Database=anjal;Username=anjal;Password=CHANGE-ME
ANJAL_MAILDIR_ROOT=/var/mail/anjal

# The Anjal operators (rc.14): the addresses, comma-separated, that may open
# the Anjal console (/ops) - they run the service, they never see anyone's
# mail. The weekly service summary and the alert mails go to them. Required:
# without it nobody can open the console and nobody hears of a problem.
ANJAL_OPERATORS=CHANGE-ME

# Keys that sign the session cookie and form tokens (DEF-050). install.sh
# creates the folder, private to the anjal user. Losing them signs everyone
# out once; nothing else depends on them.
ANJAL_WEBMAIL_KEYS_DIR=/var/lib/anjal/webmail-keys

# ACME: this process obtains and renews the certificate.
ANJAL_ACME_DOMAINS=mail.anjal.co.in
ANJAL_ACME_EMAIL=ops@anjal.co.in
ANJAL_ACME_DIR=/var/lib/anjal/acme
ANJAL_ACME_HOST=true
ANJAL_ACME_KEY=ecdsa-p256
ANJAL_ACME_RENEW_DAYS=30
# ANJAL_ACME_STAGING=true   # first run only - see DEPLOY.md section 7

# MTA-STS (v1.0.0-rc.10, RFC 8461): the policy at
# https://mta-sts.<domain>/.well-known/mta-sts.txt. Off by default. Add
# mta-sts.<domain> to ANJAL_ACME_DOMAINS first; publish the _mta-sts TXT
# record last (DEPLOY.md 13i).
#ANJAL_MTA_STS_MODE=testing          # off, testing, enforce or none
#ANJAL_MTA_STS_DOMAINS=anjal.co.in   # default: the server name's parent domain
#ANJAL_MTA_STS_MX=mail.anjal.co.in   # default: the server name
#ANJAL_MTA_STS_MAX_AGE=86400         # default: a day in testing, a week in enforce

# rc.22: the domain individuals' addresses are made on, and the parent of every
# organisation's automatic subdomain (<slug>.anjalmail.com). Its DNS - MX to this
# server, SPF, DKIM at default._domainkey, DMARC, and a wildcard MX for the
# subdomains - is yours to publish (DEPLOY.md, section 13j).
ANJAL_SHARED_DOMAIN=anjalmail.com

# rc.22: the ClamAV daemon. host:port, or the path of clamd's Unix socket.
# Unset: files are not scanned. The webmail uses it to scan held mail again and
# for the console's Virus scanning page; the mail server scans on arrival.
#ANJAL_CLAMAV=/var/run/clamav/clamd.ctl

# rc.24: lists of known dangerous links, both off until a paid list is bought (the
# free ones do not allow use in a paid service). A file of host names or addresses,
# one per line; and a DNS list zone for domain names.
#ANJAL_LINK_BLOCKLIST=/etc/anjal/link-blocklist.txt
#ANJAL_LINK_DNSBL=

# rc.22: the operator reminded every thirty minutes while mail is held because
# the virus scanner is down (the same setting the mail server uses).
#ANJAL_POSTMASTER=ops@anjal.co.in

# Time zone for dates Anjal writes into messages (v1.0.0-rc.8): an IANA name,
# written with its true offset. Default shown; unknown names fall back to UTC.
#ANJAL_TIMEZONE=Asia/Kolkata

# Dashboards (v1.0.0-rc.15, items 59 and 61).
# Where sign-ins come from: the free DB-IP "IP to City Lite" list (Creative
# Commons Attribution 4.0; the organisation dashboard credits DB-IP with a
# link), downloaded from download.db-ip.com once a month and searched on this
# server - no address leaves it. "download" is the default on Linux; "file"
# uses a list put in place by hand; "off" shows no places.
#ANJAL_GEO_MODE=download
#ANJAL_GEO_FILE=/var/lib/anjal/ip-locations.bin
# Each organisation's MX, SPF, DKIM, DMARC and MTA-STS records are checked
# once a day for its dashboard; "off" stops the check.
#ANJAL_DNS_CHECK=on
# The backup copies waiting on this server, shown in the disk bar
# (the same folder backup.sh uses).
#ANJAL_BACKUP_SCRATCH=/var/lib/anjal/backup
