# Source files: CRLF (matches the rest of the C# tooling on Windows).
*.cs text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.sql text eol=crlf
*.ps1 text eol=crlf
# Web and build files: CRLF too (rc.15, 11 Oct 2026). Without a rule, a Linux checkout
# kept them as stored while the generators write CRLF, so CI saw tokens.css as changed.
*.razor text eol=crlf
*.js text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# Python and shell scripts: LF.
*.py text eol=lf
*.sh text eol=lf

# YAML files (used by GitHub Actions): LF.
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - no translation.
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.xlsx binary
