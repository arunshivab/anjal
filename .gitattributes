# Line endings: one rule for every file type (owner, 11 Oct 2026).
# tools/check_eol.py fails CI when a tracked file has no explicit rule here, when
# .editorconfig disagrees with this file, or when a file's bytes break its rule
# (wrong ending, stray CR, byte-order mark). Add a new file type here AND in
# .editorconfig in the same change.

# Safety net only: a type missing below is still guessed sensibly, but CI fails
# until it has its own line.
* text=auto eol=crlf

# Windows-edited sources, docs and web files: CRLF.
*.cs text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.sql text eol=crlf
*.ps1 text eol=crlf
*.razor text eol=crlf
*.js text eol=crlf
*.css text eol=crlf
*.html text eol=crlf
*.svg text eol=crlf
.gitattributes text eol=crlf
.gitignore text eol=crlf
.editorconfig text eol=crlf

# Run or read on Linux (scripts, workflows, systemd units, env templates): LF.
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.example text eol=lf

# Binary: never translated.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
*.woff2 binary
*.nupkg binary
