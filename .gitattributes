# .gitattributes - controls how git treats line endings and binary files.
#
# Without this file, Windows clients with core.autocrlf=true would convert
# CRLF to LF on commit, which makes our .editorconfig (which mandates CRLF)
# fail on Linux CI runners. Here we pin specific file types to CRLF so the
# stored bytes always match the editorconfig rule, regardless of the
# contributor's autocrlf setting.

# Default: let git auto-detect text and normalize on commit.
* text=auto

# Source files - always CRLF in the working tree and in the repo.
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.ps1       text eol=crlf
*.psm1      text eol=crlf

# YAML and Python conventionally use LF.
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf

# Docs and config that travel cross-platform: CRLF since editorconfig says CRLF.
*.md             text eol=crlf
*.editorconfig   text eol=crlf
*.gitignore      text eol=crlf
*.gitattributes  text eol=crlf

# Binary - never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.dll       binary
*.exe       binary
*.pfx       binary
*.snk       binary