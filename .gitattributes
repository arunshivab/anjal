# Source files: CRLF (matches the rest of the C# tooling on Windows).
*.cs text eol=crlf
*.csproj text eol=crlf
*.slnx text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.sql text eol=crlf
*.ps1 text eol=crlf

# Python and shell scripts: LF.
*.py text eol=lf
*.sh text eol=lf

# YAML files (used by GitHub Actions): LF.
*.yml text eol=lf
*.yaml text eol=lf

# Binary files - no translation.
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
