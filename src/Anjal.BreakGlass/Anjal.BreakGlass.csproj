<Project Sdk="Microsoft.NET.Sdk">

  <!-- rc.25 (DES-15 §6.3, OPS-16): the offline tool for Anjal's break-glass key. It is run only on an
       offline computer; it is never installed on a server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1303;CA1812;CA1515;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anjal.Store\Anjal.Store.csproj" />
  </ItemGroup>

</Project>
