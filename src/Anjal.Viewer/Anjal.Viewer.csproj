<Project Sdk="Microsoft.NET.Sdk">

  <!-- rc.29 (DES-22 §4, D-358): anjal-viewer, the separate process that reads every attachment shown in the mail
       window. The only Anjal program that references the file libraries (DES-22 §11). -->

  <ItemGroup>
    <ProjectReference Include="..\Anjal.Viewing\Anjal.Viewing.csproj" />
    <ProjectReference Include="..\Anjal.Mime\Anjal.Mime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Chuvadi.Pdf" Version="3.34.0" />
    <PackageReference Include="Chuvadi.Docs" Version="2.2.0" />
    <PackageReference Include="Chuvadi.Sheets" Version="2.1.0" />
    <!-- AC-20: every ZIP the viewer reads, locked ones among them. -->
    <PackageReference Include="Chuvadi.Zip" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Anjal.Viewer.Tests" />
  </ItemGroup>

  <!-- rc.30 (D-372, AC-19): the DICOM preview, on SIAARA v0.1.0-rc.1 from localpackages (verified 18 Nov 2026:
       SHA-256 and SSHSIG release signature). Always built; shown only with ANJAL_VIEWER_DICOM=on, off by default
       until v0.1.0. -->
  <ItemGroup>
    <PackageReference Include="Siaara" Version="0.1.0-rc.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Anjal.Viewer</AssemblyName>
    <!-- AC-12: published trimmed and ReadyToRun (deploy/publish.ps1, the deploy-smoke job). -->
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- AC-20: Chuvadi.Zip 1.0.0 carries no trimming marker; kept whole until its next version. (AC-22: Sheets 2.1.0 is marked and is trimmed like the rest.) -->
    <TrimmerRootAssembly Include="Chuvadi.Zip" />
  </ItemGroup>

</Project>
