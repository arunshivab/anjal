@* rc.16: the heat map as a table - each weekday, its mail in four parts of the day. *@
@{ var inv = System.Globalization.CultureInfo.InvariantCulture; }
<table class="dtable">
    <thead><tr><th scope="col">@L["Day"]</th><th scope="col" class="num">00–06</th><th scope="col" class="num">06–12</th><th scope="col" class="num">12–18</th><th scope="col" class="num">18–24</th><th scope="col" class="num">@L["Total"]</th></tr></thead>
    <tbody>
        @for (int d = 0; d < 7; d++)
        {
            long total = 0;
            <tr>
                <th scope="row">@L[Days[d]]</th>
                @for (int q = 0; q < 4; q++)
                {
                    long n = 0;
                    for (int h = q * 6; h < q * 6 + 6; h++) { n += Cells[d, h]; }
                    total += n;
                    <td class="num">@n.ToString("N0", inv)</td>
                }
                <td class="num"><b>@total.ToString("N0", inv)</b></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private static readonly string[] Days = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    /// <summary>Counts by weekday (Monday first) and hour.</summary>
    [Parameter] public long[,] Cells { get; set; } = new long[7, 24];

    /// <summary>The page's words.</summary>
    [Parameter] public Lexicon L { get; set; } = new("en", new Dictionary<string, string>());
}
