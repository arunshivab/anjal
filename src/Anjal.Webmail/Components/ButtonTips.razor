@* rc.15 (item 5, owner 7 Oct): a short tip on every text button, in the person's language. A data
   block, never run: the script reads it as JSON and gives each text button whose words match a
   tip, unless it already has one. *@
<script type="application/json" id="anjal-tips">@((MarkupString)Json)</script>

@code {
    /// <summary>The page's words.</summary>
    [Parameter] public Lexicon L { get; set; } = new("en", new Dictionary<string, string>());

    /// <summary>True for an organisation's administrator: the organisation console's buttons get tips too.</summary>
    [Parameter] public bool Admin { get; set; }

    /// <summary>True for an operator of this Anjal service: the Anjal console's buttons get tips too.</summary>
    [Parameter] public bool Operator { get; set; }

    private static readonly System.Text.Json.JsonSerializerOptions Options = new() { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default };

    private string Json => System.Text.Json.JsonSerializer.Serialize(Map(), Options);

    // The button's words, as shown, to its tip.
    private Dictionary<string, string> Map()
    {
        var all = new Dictionary<string, string>(StringComparer.Ordinal);
        IEnumerable<(string Label, string Tip)> pairs = Pairs();
        if (Admin)
        {
            pairs = pairs.Concat(AdminPairs());
        }
        if (Operator)
        {
            pairs = pairs.Concat(OperatorPairs());
        }
        foreach ((string label, string tip) in pairs)
        {
            all.TryAdd(label, tip);
        }
        return all;
    }

    private IEnumerable<(string Label, string Tip)> Pairs() => new Dictionary<string, string>(StringComparer.Ordinal)
