@* The formatting toolbar, shared by compose and the signature. Hidden until
   the browser script enables the editor, so it never appears without
   JavaScript. Uniform square buttons in four groups; the script marks the
   ones whose formatting is active at the cursor (aria-pressed). Icons are
   LiPicons where the set has one, otherwise small drawn glyphs. *@
<div class="rte-bar" role="toolbar" aria-label="Formatting" data-rte-bar hidden>
    <span class="rte-grp">
        <button type="button" class="rte-btn" data-cmd="bold" title="Bold (Ctrl+B)" aria-label="Bold" aria-pressed="false"><b class="rte-b">B</b></button>
        <button type="button" class="rte-btn" data-cmd="italic" title="Italic (Ctrl+I)" aria-label="Italic" aria-pressed="false"><i class="rte-i">I</i></button>
        <button type="button" class="rte-btn" data-cmd="underline" title="Underline (Ctrl+U)" aria-label="Underline" aria-pressed="false"><LipiIcon Name="underline" Size="16" /></button>
    </span>
    <span class="rte-sep" aria-hidden="true"></span>
    <span class="rte-grp">
        <button type="button" class="rte-btn" data-cmd="insertUnorderedList" title="Bulleted list" aria-label="Bulleted list" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="3" cy="4" r="1.3" fill="currentColor" /><circle cx="3" cy="8" r="1.3" fill="currentColor" /><circle cx="3" cy="12" r="1.3" fill="currentColor" /><path d="M6.5 4h7M6.5 8h7M6.5 12h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" /></svg>
        </button>
        <button type="button" class="rte-btn" data-cmd="insertOrderedList" title="Numbered list" aria-label="Numbered list" aria-pressed="false">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2.2 2.8h1.2v3M2 5.8h2.4M1.9 9.4c.3-.6 1.9-.7 1.9.3 0 .8-1.9 1.4-1.9 2.4h2.1" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" fill="none" /><path d="M6.5 4h7M6.5 8h7M6.5 12h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" /></svg>
        </button>
    </span>
    <span class="rte-sep" aria-hidden="true"></span>
    <span class="rte-grp">
        <button type="button" class="rte-btn" data-cmd="link" title="Insert a link" aria-label="Insert a link"><LipiIcon Name="link" Size="16" /></button>
        <button type="button" class="rte-btn" data-cmd="quote" title="Quote" aria-label="Quote">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2.5 12V9.2c0-2.6 1-4.2 3.2-5.2l.5 1c-1.2.6-1.8 1.4-1.9 2.6h1.9V12zM9 12V9.2c0-2.6 1-4.2 3.2-5.2l.5 1c-1.2.6-1.8 1.4-1.9 2.6h1.9V12z" fill="currentColor" /></svg>
        </button>
    </span>
    <span class="rte-sep" aria-hidden="true"></span>
    <button type="button" class="rte-btn" data-cmd="clear" title="Clear formatting" aria-label="Clear formatting">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 3.5h8M7 3.5V13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" /><path d="M10 10l4 4M14 10l-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none" /></svg>
    </button>
</div>
