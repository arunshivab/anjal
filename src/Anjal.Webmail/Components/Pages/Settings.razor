    private static string Title(string t) => t.Length == 0 ? t : char.ToUpperInvariant(t[0]) + t.Substring(1);

    private string Ago(DateTimeOffset at)
    {
        TimeSpan d = DateTimeOffset.UtcNow - at;
        return d < TimeSpan.FromMinutes(2) ? L["just now"]
            : d < TimeSpan.FromHours(1) ? L["{n} minutes ago"].Replace("{n}", ((int)d.TotalMinutes).ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)
            : d < TimeSpan.FromHours(2) ? L["an hour ago"]
            : d < TimeSpan.FromDays(1) ? L["{n} hours ago"].Replace("{n}", ((int)d.TotalHours).ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)
            : d < TimeSpan.FromDays(2) ? L["yesterday"]
            : L["{n} days ago"].Replace("{n}", ((int)d.TotalDays).ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (AuthState is null)
        {
            return;
        }
        System.Security.Claims.ClaimsPrincipal user = (await AuthState).User;
        isOperator = Operators.Is(user.Identity?.Name);
        L = Words.For(WebmailAuthService.LanguageOf(user, Words));
        clock = WebmailAuthService.ClockOf(user);
        Guid? mailboxId = WebmailAuthService.PersonIdOf(user);
        if (mailboxId is null)
        {
            return;
        }
        note = AuthEndpoints.ReadNote(Protection, E);
        if (note is not null && note.Contains("used that password before", StringComparison.Ordinal))
        {
            failedRules = new[] { "history" };
        }
        (TenantRow Tenant, MailboxRow Mailbox)? context = await Mail.GetContextAsync(mailboxId.Value);
        if (context is not null)
        {
            displayName = context.Value.Mailbox.DisplayName;
            if (Current == "profile")
            {
                profile = await Mail.ProfileOfAsync(mailboxId.Value);
                individual = await Mail.IsIndividualAsync(mailboxId.Value);
                // DEF-130 (rc.23): no nicknames means none - also for a person whose first and last name were never recorded.
                nicknames = await Mail.NicknamesAllowedAsync(mailboxId.Value);
                namesMissing = !nicknames && profile.FullName.Length == 0;
            }
            if (Current == "appearance")
            {
                sections = await Mail.SectionsOfAsync(mailboxId.Value);
            }
            if (Current == "away")
            {
                away = await Mail.AwayOfAsync(mailboxId.Value);
                awayOutsideAllowed = await Mail.IsIndividualAsync(mailboxId.Value) || (await Mail.MailPolicyOfAsync(context.Value.Tenant.Id)).AwayOutside;
            }
            if (Current == "data")
            {
                profile = await Mail.ProfileOfAsync(mailboxId.Value);
                export = await Mail.ExportStateAsync(mailboxId.Value);
                deletion = await Mail.DeletionRequestOfAsync(mailboxId.Value);
                retention = await Mail.RetentionOfAsync(context.Value.Tenant);
            }
            theme = MailboxRow.NormalizeTheme(context.Value.Mailbox.Theme);
            colour = theme[..theme.LastIndexOf('-')];
            mode = theme[(theme.LastIndexOf('-') + 1)..];
            MailboxPreferences prefs = MailboxPreferences.Of(context.Value.Mailbox).Normalized();
            density = prefs.Density;
            zoom = prefs.Zoom;
            layout = prefs.Layout;
            language = prefs.Language;
            timeZone = prefs.TimeZone;
            dateFormat = prefs.DateFormat;
            weekStart = prefs.WeekStart;
            pageSize = prefs.PageSize;
            sound = prefs.NewMailSound;
            quota = context.Value.Mailbox.QuotaBytes;
            used = context.Value.Mailbox.UsedBytes;
            address = context.Value.Mailbox.Address;
            tenantSlug = context.Value.Tenant.Slug;
            clockOwn = Clocks.Choice((await Mail.GetMailSettingsAsync(mailboxId.Value)).Clock);
            tenantName = string.IsNullOrWhiteSpace(context.Value.Tenant.DisplayName)
                ? context.Value.Tenant.Slug
                : context.Value.Tenant.DisplayName;
        }
        switch (Current)
        {
            case "categories":
            case "senders":
                categories = await Mail.ListCategoriesAsync(mailboxId.Value);
                rules = await Mail.ListCategoryRulesAsync(mailboxId.Value);
                senderRules = await Mail.ListSenderRulesAsync(mailboxId.Value);
                discards = await Mail.DiscardCountsAsync(mailboxId.Value);
                break;
            case "mail":
                shared = SessionRegistry.IsShared(user);
                (offlineAllowed, offlineOn) = await Mail.OfflineMailAsync(mailboxId.Value, shared);
                offlinePasskeys = (await Mail.GetSecurityAsync(mailboxId.Value)).Passkeys.Select(k => k.Id).ToList();
                if (context is not null)
                {
                    junkDays = (await Mail.RetentionOfAsync(context.Value.Tenant)).JunkDays;
                }
                (signatureHtml, signatureText) = await Mail.GetSignatureAsync(mailboxId.Value);
                mailSettings = await Mail.GetMailSettingsAsync(mailboxId.Value);
                trashRule = await Mail.TrashRuleForAsync(mailboxId.Value);
                junkDays = trashRule.JunkDays;
                contactSettings = await Mail.GetContactSettingsAsync(mailboxId.Value);
                break;
            case "security":
                figures = context is null ? new PersonFiguresSetting() : await Mail.PersonFiguresOfAsync(context.Value.Tenant.Id);
                policy = await Mail.SignInPolicyForAsync(mailboxId.Value);
                pwLength = context is null ? pwLength : await Mail.PasswordLengthForAsync(context.Value.Mailbox, null);
                demand = await Mail.SignInDemandAsync(mailboxId.Value);
                sessionId = SessionRegistry.SessionOf(user);
                security = await Mail.GetSecurityAsync(mailboxId.Value);
                devices = await Sessions.ListAsync(mailboxId.Value, sessionId);
                if (Sub == "two-step")
                {
                    codes = Codes is not null ? Sessions.TakeReveal(sessionId) : null;
                    setup = await Mail.GetAuthenticatorSetupAsync(mailboxId.Value);
                }
                break;
        }
    }
