@page "/dashboard"
@attribute [Authorize]
@inject MailboxService Mail
@inject Words Words
@inject SessionRegistry Sessions

<PageTitle>@L["Dashboard"] — Anjal</PageTitle>

@* rc.15: the person's dashboard as the approved board draws it (Dashboard,
   PhoneDashboard; items 56, 58, 63): it opens on Today; each graph has its
   own period; Reset returns all of them to Today; every count opens what
   it counts. Only this mailbox - or a shared one the person holds a right
   on - is shown. On a phone: Unread, Needs attention, Activity and the
   table, nothing else. *@
@if (!loaded)
{
    <div class="dash"><p class="dnote">@L["Loading your figures…"]</p></div>
}
else
{
<div class="dash">
    <header class="dhead">
        <div>
            <h1>@L["Your dashboard"]</h1>
            <p class="dsub">@box!.Address. @clock.Full(now)</p>
        </div>
        <div class="dheadbtns">
            @if (isAdmin)
            {
                <nav class="seg dtoggle" aria-label="@L["Whose figures"]"><a href="/dashboard" aria-current="page">@L["Yours"]</a><a href="/dashboard/org">@orgName</a></nav>
            }
            @if (boxes.Count > 1)
            {
                <form method="get" action="/dashboard" class="dboxpick">
                    <select name="box" class="setsel" aria-label="@L["Mailbox"]" data-autosubmit>
                        @foreach (MailboxRow b in boxes)
                        {
                            <option value="@b.Id" selected="@(b.Id == box.Id)">@b.Address</option>
                        }
                    </select>
                    <noscript><button type="submit" class="btn btn-s btn-sm">@L["Show"]</button></noscript>
                </form>
            }
            <a class="btn btn-s" href="@ResetLink">@L["Reset all to Today"]</a>
        </div>
    </header>

    <div class="dgrid">
        <section class="dcard dunread">
            @* rc.15 (owner, 7 Oct): a message opens itself; only the heading goes to the Inbox. *@
            <h2><a href="/folder/INBOX" class="dh-link">@L["Unread"] @unreadCount.ToString("N0", Inv)<LipiIcon Name="chevron-right" Size="16" /></a></h2>
            @if (unread.Count == 0)
            {
                <p class="dnote dclear"><LipiIcon Name="check" Size="16" />@L["Nothing unread in your Inbox."]</p>
            }
            else
            {
                <ul class="ulist">
                    @foreach (MessageRow m in unread)
                    {
                        <li>
                            <a href="/folder/INBOX?open=@m.Id">
                                <span class="u-av" aria-hidden="true">@Initials(Sender(m))</span><span class="u-main"><span class="u-top"><b>@Sender(m)</b><span class="u-time">@clock.List(m.ReceivedAt, now)</span>@if (!SpamCheck.WasChecked(m, FolderRow.Inbox)) {<span class="score s-none" title="@L["Not checked: your own mail or mail from this server"]">&ndash;</span>} else if (m.SpamScore > 0) {<span class="score @(m.SpamScore >= threshold ? "s-hi" : "s-mid")" title="@L["Checked on arrival: spam score {n}"].Replace("{n}", m.SpamScore.ToString(Inv), StringComparison.Ordinal)">@m.SpamScore</span>} else {<span class="score s-zero" title="@L["Checked on arrival: nothing suspicious"]">0</span>}</span>
                                <span class="u-subj">@Subject(m)</span></span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </section>
        <section class="dcard">
            <h2>@L["Needs attention"]</h2>
            <DashLines Lines="attention" L="L" Empty="@L["Nothing needs you: no drafts left, nothing waiting in the Outbox, and every message you sent has had its reply."]" />
        </section>
        <section class="dcard nophone">
            <h2>@L["Your safety"]</h2>
            <DashLines Lines="safety" L="L" Empty="" />
        </section>
        @* On a phone the activity comes before the table (board PhoneDashboard). *@
        <section class="dcard span2 dsplitcard" id="d-activity">
            <div class="dpart-table">
                <h2>@L["Received, sent and Junk"]</h2>
                <CountsTable Rows="table" L="L" Link="CountLink" Note="@(L["Today and Yesterday are calendar days in {zone}; the others end now. Each number opens those messages."].Replace("{zone}", clock.ZoneName(now), StringComparison.Ordinal))" />
            </div>
            <div class="dsplit"></div>
            <div class="dpart-act">
                <div class="dcardhead">
                    <h3>@L[ActivityTitle]</h3>
                    <PeriodChips Current="@activityPeriod.Key" Href="@(k => Link("a", k) + "#d-activity")" For="@L["Activity"]" L="L" />
                </div>
                <TimeChart Bars="bars" L="L" Link="BarLink" />
            </div>
        </section>
        <section class="dcard nophone dhealth">
            <h2>@L["Mailbox health"]</h2>
            @* rc.15: how full the mailbox is, as a ring. *@
            <div class="dring @(MailboxService.Fullness(box) >= 90 ? "bad" : MailboxService.Fullness(box) >= 80 ? "warn" : null)" style="--p:@MailboxService.Fullness(box).ToString(Inv)" role="img" aria-label="@L["{p}% used"].Replace("{p}", MailboxService.Fullness(box).ToString(Inv), StringComparison.Ordinal)">
                <div class="dring-text"><b>@MailboxService.Fullness(box).ToString(Inv)%</b><span>@L["used"]</span></div>
            </div>
            @* rc.15 (item 56): the size opens the biggest messages first. *@
            <p class="dbig dcenter"><a href="@BiggestFirst" class="dh-link" title="@L["Open the biggest messages first"]"><b>@Layout.MainLayout.Size(box.UsedBytes)</b> @(box.QuotaBytes > 0 ? L["of {quota}"].Replace("{quota}", Layout.MainLayout.Size(box.QuotaBytes), StringComparison.Ordinal) : string.Empty)</a></p>
            <DashLines Lines="health" L="L" Empty="" />
        </section>
        <section class="dcard nophone" id="d-folder">
            <div class="dcardhead col">
                <h2>@L["By folder"]</h2>
                <PeriodChips Current="@folderPeriod.Key" Href="@(k => Link("f", k) + "#d-folder")" For="@L["By folder"]" Class="small" L="L" />
            </div>
            <BarList Items="byFolder" Tone="h-brand" Empty="@L["Nothing received in this period."]" />
        </section>
        <section class="dcard nophone" id="d-category">
            <div class="dcardhead col">
                <h2>@L["By category"]</h2>
                <PeriodChips Current="@categoryPeriod.Key" Href="@(k => Link("c", k) + "#d-category")" For="@L["By category"]" Class="small" L="L" />
            </div>
            <BarList Items="byCategory" Tone="h-brand" Empty="@L["Nothing received in this period."]" />
        </section>
        <section class="dcard nophone" id="d-who">
            <div class="dcardhead col">
                <h2>@L["Who wrote to you most"]</h2>
                <PeriodChips Current="@whoPeriod.Key" Href="@(k => Link("w", k) + "#d-who")" For="@L["Who wrote to you most"]" Class="small" L="L" />
            </div>
            <BarList Items="bySender" Tone="h-accent" Empty="@L["Nothing received in this period."]" />
        </section>
        <section class="dcard span2 nophone" id="d-scores">
            <div class="dcardhead">
                <h2>@L["Messages by spam score"]</h2>
                <PeriodChips Current="@scorePeriod.Key" Href="@(k => Link("s", k) + "#d-scores")" For="@L["Messages by spam score"]" L="L" />
            </div>
            <ScoreChart Scores="scores.Scores" Threshold="threshold" Checked="scores.Checked" Link="ScoreLink" L="L"
                        Note="@(L["{n} checked {period}; {j} at or over your organisation's Junk line. Click a bar to list its messages."].Replace("{n}", scores.Checked.ToString("N0", Inv), StringComparison.Ordinal).Replace("{period}", L[scorePeriod.Label].ToLowerInvariant(), StringComparison.Ordinal).Replace("{j}", scores.Scores.Skip(threshold).Sum().ToString("N0", Inv), StringComparison.Ordinal))" />
        </section>
        <section class="dcard nophone" id="d-space">
            <h2>@L["Space by folder"]</h2>
            @* rc.15 (item 58): what each folder takes, in MB; each opens its folder. *@
            <BarList Items="space" Tone="h-brand" Show="Mb" Empty="@L["Your mailbox is empty."]" />
        </section>
        @if (box.Id == personId)
        {
            <section class="dcard nophone dhabits" id="d-habits">
                <div class="dcardhead">
                    <h2>@L["Your habits"]</h2>
                    <form method="post" action="/settings/habits">
                        <AntiforgeryToken />
                        <input type="hidden" name="back" value="/dashboard#d-habits" />
                        <input type="hidden" name="on" value="@(habitsOn ? "0" : "1")" />
                        <button type="submit" class="btn btn-s btn-sm" title="@L[habitsOn ? "Stop working out your habits" : "Show how quickly you reply and your busiest hours"]">@L[habitsOn ? "Turn off" : "Turn on"]</button>
                    </form>
                </div>
                @if (!habitsOn)
                {
                    <p class="dnote">@L["Off. Nothing is worked out about how you use your mail."]</p>
                }
                else if (habits is not null)
                {
                    @if (habits.MedianReply is TimeSpan reply)
                    {
                        <p class="bigline"><b>@SpanText(reply)</b> @L["is how long you usually take to reply"]</p>
                        <p class="dnote">@(habits.Replies == 1 ? L["From 1 reply in the last 30 days."] : L["From {n} replies in the last 30 days."].Replace("{n}", habits.Replies.ToString(Inv), StringComparison.Ordinal))</p>
                    }
                    else
                    {
                        <p class="dnote">@L["No replies in the last 30 days to work out how quickly you reply."]</p>
                    }
                    <div class="hourbars" role="img" aria-label="@L["Messages by hour of the day, last 30 days"]">
                        @for (int h = 0; h < 24; h++)
                        {
                            <i class="@(habits.Busiest.Contains(h) ? "busy" : null)" style="height:@HourHeight(h)%" title="@HourLabel(h): @habits.ByHour[h].ToString("N0", Inv)"></i>
                        }
                    </div>
                    <div class="hourticks" aria-hidden="true"><span>@HourLabel(0)</span><span>@HourLabel(6)</span><span>@HourLabel(12)</span><span>@HourLabel(18)</span><span>@HourLabel(23)</span></div>
                    @if (habits.Busiest.Count > 0)
                    {
                        <p class="dnote">@L["Busiest hours: {hours}."].Replace("{hours}", string.Join(", ", habits.Busiest.Select(HourLabel)), StringComparison.Ordinal) @L["Seen only by you."]</p>
                    }
                }
            </section>
        }






    </div>
    <p class="dnote phoneonly dfoot">@L["The full dashboard is on a larger screen."]</p>
</div>
}

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [SupplyParameterFromQuery(Name = "box")] private string? BoxText { get; set; }
    [SupplyParameterFromQuery(Name = "a")] private string? A { get; set; }
    [SupplyParameterFromQuery(Name = "s")] private string? S { get; set; }
    [SupplyParameterFromQuery(Name = "f")] private string? F { get; set; }
    [SupplyParameterFromQuery(Name = "c")] private string? C { get; set; }
    [SupplyParameterFromQuery(Name = "w")] private string? W { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Lexicon L = new("en", new Dictionary<string, string>());
    private ZonedClock clock = ZonedClock.Default;
    private DateTimeOffset now = DateTimeOffset.UtcNow;
    private bool loaded;
    private bool isAdmin;
    private string orgName = string.Empty;
    private MailboxRow? box;
    private IReadOnlyList<MailboxRow> boxes = Array.Empty<MailboxRow>();
    private int threshold = TenantRow.DefaultSpamThreshold;
    private IReadOnlyList<(DashPeriod Period, MailFigures Figures)> table = Array.Empty<(DashPeriod, MailFigures)>();
    private DashPeriod activityPeriod = null!;
    private DashPeriod scorePeriod = null!;
    private DashPeriod folderPeriod = null!;
    private DashPeriod categoryPeriod = null!;
    private DashPeriod whoPeriod = null!;
    private IReadOnlyList<ChartBar> bars = Array.Empty<ChartBar>();
    private MailFigures scores = new();
    private long unreadCount;
    private IReadOnlyList<MessageRow> unread = Array.Empty<MessageRow>();
    private IReadOnlyList<DashLine> attention = Array.Empty<DashLine>();
    private IReadOnlyList<(string, long, string?, int)> byFolder = Array.Empty<(string, long, string?, int)>();
    private IReadOnlyList<(string, long, string?, int)> byCategory = Array.Empty<(string, long, string?, int)>();
    private IReadOnlyList<(string, long, string?, int)> bySender = Array.Empty<(string, long, string?, int)>();
    private IReadOnlyList<DashLine> health = Array.Empty<DashLine>();
    private IReadOnlyList<DashLine> safety = Array.Empty<DashLine>();
    private IReadOnlyList<(string, long, string?, int)> space = Array.Empty<(string, long, string?, int)>();
    private Guid personId;

    // rc.15 (item 56): the mailbox's size opens its biggest messages first.
    private const string BiggestFirst = "/search?scope=all&sort=size";
    private bool habitsOn;
    private MailHabits? habits;

    // rc.15 (item 58): space in MB, as the owner asked; two decimals, as every size (owner, 9 Oct).
    private static string Mb(long bytes) => Sizes.Megabytes(bytes);

    private string SpanText(TimeSpan t) =>
        t < TimeSpan.FromHours(1) ? L["{n} min"].Replace("{n}", Math.Max(1, (int)Math.Round(t.TotalMinutes)).ToString(Inv), StringComparison.Ordinal)
        : t < TimeSpan.FromHours(48) ? L["{n} h"].Replace("{n}", ((int)Math.Round(t.TotalHours)).ToString(Inv), StringComparison.Ordinal)
        : L["{n} days"].Replace("{n}", ((int)Math.Round(t.TotalDays)).ToString(Inv), StringComparison.Ordinal);

    // An hour of the day in the person's clock (24-hour or 12-hour).
    private string HourLabel(int hour) => clock.Time(MailboxService.AtLocal(clock, clock.Local(now).Date.AddHours(hour)));

    private string HourHeight(int hour)
    {
        long max = Math.Max(1, habits?.ByHour.Max() ?? 1);
        long n = habits?.ByHour[hour] ?? 0;
        return (n == 0 ? 2 : Math.Max(6, n * 100 / max)).ToString(Inv);
    }

    private string ActivityTitle => activityPeriod.Step switch { TimeStep.Hour => "Activity, by hour", TimeStep.Day => "Activity, by day", TimeStep.Week => "Activity, by week", _ => "Activity, by month" };

    private string ResetLink => box is not null && boxes.Count > 1 && box.Id != boxes[0].Id ? "/dashboard?box=" + box.Id : "/dashboard";

    // The page's address with one graph's period changed and the others kept.
    private string Link(string card, string key)
    {
        var q = new List<string>();
        if (box is not null && boxes.Count > 1 && box.Id != boxes[0].Id)
        {
            q.Add("box=" + box.Id);
        }
        foreach ((string k, string? v) in new[] { ("a", A), ("s", S), ("f", F), ("c", C), ("w", W) })
        {
            string value = k == card ? key : v ?? "today";
            if (value != "today")
            {
                q.Add(k + "=" + Uri.EscapeDataString(value));
            }
        }
        return "/dashboard" + (q.Count > 0 ? "?" + string.Join("&", q) : string.Empty);
    }

    // A search over the period, in the folder that holds what the count counts.
    private string Range(DashPeriod p) =>
        "&after=" + clock.Local(p.Start).ToString("yyyy-MM-dd", Inv) + "&before=" + clock.Local(p.End.AddTicks(-1)).ToString("yyyy-MM-dd", Inv);

    private string? CountLink(string kind, DashPeriod p) => box is null ? null : kind switch
    {
        "sent" => "/search?scope=Sent" + Range(p),
        "junk" => "/search?scope=Junk" + Range(p),
        _ => "/search?scope=INBOX" + Range(p),
    };

    // Item 56: a step of the time chart opens its days' mail (an hour opens its whole day).
    private string? BarLink(ChartBar b) => box is null ? null
        : "/search?scope=all&after=" + b.Start.ToString("yyyy-MM-dd", Inv) + "&before=" + b.End.AddTicks(-1).ToString("yyyy-MM-dd", Inv);

    private string? ScoreLink(int score) => "/search?scope=all&score=" + score.ToString(Inv) + Range(scorePeriod);

    // Up to two letters for a sender's round mark: the first of the first two words.
    private static string Initials(string name)
    {
        string[] words = name.Split(new[] { ' ', '.', '_', '@' }, StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 0 ? "?" : string.Concat(words.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    }

    private static string Sender(MessageRow m)
    {
        IReadOnlyList<Anjal.Mime.MailAddress> parsed = Anjal.Mime.AddressParser.Parse(Anjal.Mime.EncodedWordDecoder.Decode(m.FromHeader));
        return parsed.Count > 0 ? (parsed[0].DisplayName.Length > 0 ? parsed[0].DisplayName : parsed[0].Address) : m.EnvelopeFrom;
    }

    private string Subject(MessageRow m)
    {
        string s = Anjal.Mime.EncodedWordDecoder.Decode(m.Subject).Trim();
        return s.Length > 0 ? s : L["(no subject)"];
    }

    protected override async Task OnParametersSetAsync()
    {
        loaded = false;
        if (AuthState is null)
        {
            return;
        }
        System.Security.Claims.ClaimsPrincipal user = (await AuthState).User;
        L = Words.For(WebmailAuthService.LanguageOf(user, Words));
        clock = WebmailAuthService.ClockOf(user);
        now = DateTimeOffset.UtcNow;
        if (WebmailAuthService.PersonIdOf(user) is not Guid person || await Mail.GetContextAsync(person) is not { } context)
        {
            return;
        }
        // The person's own mailbox first, then the shared ones they hold a right on.
        var list = new List<MailboxRow> { context.Mailbox };
        list.AddRange((await Mail.SharedForPersonAsync(person)).Select(s => s.Mailbox));
        boxes = list;
        box = Guid.TryParse(BoxText, out Guid wanted) ? boxes.FirstOrDefault(b => b.Id == wanted) ?? context.Mailbox : context.Mailbox;
        isAdmin = await Mail.IsOrgAdminAsync(person);
        orgName = context.Tenant.DisplayName.Length > 0 ? context.Tenant.DisplayName : context.Tenant.Slug;
        threshold = context.Tenant.SpamThreshold > 0 ? context.Tenant.SpamThreshold : TenantRow.DefaultSpamThreshold;

        FigureScope scope = FigureScope.Mailbox(box.Id);
        table = await Mail.FiguresTableAsync(scope, clock, now);
        activityPeriod = MailboxService.DashPeriodOf(A, clock, now);
        scorePeriod = MailboxService.DashPeriodOf(S, clock, now);
        folderPeriod = MailboxService.DashPeriodOf(F, clock, now);
        categoryPeriod = MailboxService.DashPeriodOf(C, clock, now);
        whoPeriod = MailboxService.DashPeriodOf(W, clock, now);
        MailFigures FiguresOf(DashPeriod p) => table.First(r => r.Period.Key == p.Key).Figures;
        bars = MailboxService.Bars(FiguresOf(activityPeriod), activityPeriod, clock);
        scores = FiguresOf(scorePeriod);

        (unreadCount, unread) = await Mail.UnreadAsync(box.Id, 5);
        attention = await Mail.PersonAttentionAsync(box.Id, clock, now);

        MailboxActivity folders = await Mail.ActivityInAsync(box.Id, folderPeriod, clock);
        byFolder = folders.ByFolder.Take(6).Select(n => (L.Folder(n.Name), n.Count, (string?)("/folder/" + Uri.EscapeDataString(n.Name)), 0)).ToList();
        MailboxActivity cats = categoryPeriod.Key == folderPeriod.Key ? folders : await Mail.ActivityInAsync(box.Id, categoryPeriod, clock);
        // rc.15 (item 56): each category's bar opens its messages in that period.
        Dictionary<string, Guid> categoryIds = (await Mail.ListCategoriesAsync(box.Id))
            .GroupBy(c => c.Row.Name, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().Row.Id, StringComparer.Ordinal);
        byCategory = cats.ByCategory.Take(6).Select(n => (n.Name == "Uncategorised" ? L["Uncategorised"] : n.Name, n.Count,
            (string?)(n.Name == "Uncategorised" ? "/search?scope=all&cat=none" + Range(categoryPeriod)
                : categoryIds.TryGetValue(n.Name, out Guid cid) ? "/search?scope=all&cat=" + cid + Range(categoryPeriod) : null), n.Slot)).ToList();
        MailboxActivity who = whoPeriod.Key == folderPeriod.Key ? folders : whoPeriod.Key == categoryPeriod.Key ? cats : await Mail.ActivityInAsync(box.Id, whoPeriod, clock);
        // Counted by address; shown by the name the person saved for it, when there is one (board Dashboard).
        Dictionary<string, string> named = (await Mail.ListContactsAsync(box.Id))
            .Where(c => c.Address.Length > 0)
            .GroupBy(c => c.Address, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First().DisplayName, StringComparer.OrdinalIgnoreCase);
        bySender = who.TopSenders.Take(5).Select(n => (named.TryGetValue(n.Name, out string? shown) ? shown : n.Name, n.Count, (string?)("/search?scope=all&sender=" + Uri.EscapeDataString(n.Name)), 0)).ToList();

        // Mailbox health: the largest folder, attachments, Junk emptied.
        IReadOnlyList<FolderView> allFolders = await Mail.ListFoldersAsync(box.Id);
        var healthLines = new List<DashLine>();
        if (allFolders.Where(f => f.Name != "Trash").OrderByDescending(f => f.Count).FirstOrDefault() is FolderView largest && largest.Count > 0)
        {
            healthLines.Add(new DashLine("folder", "{folder} holds the most mail: {n} messages", string.Empty, "/folder/" + Uri.EscapeDataString(largest.Name), string.Empty, new Dictionary<string, string>(StringComparer.Ordinal) { ["folder"] = L.Folder(largest.Name), ["n"] = largest.Count.ToString("N0", Inv) }));
        }
        MailboxActivity year = await Mail.ActivityInAsync(box.Id, MailboxService.DashPeriodOf("12m", clock, now), clock);
        long withAttachments = year.ReceivedWithAttachments + year.SentWithAttachments;
        if (withAttachments > 0)
        {
            healthLines.Add(new DashLine("attachment", "{n} messages with attachments in the last 12 months", "Attachments take most of a mailbox's space", "/search?scope=all&attach=1", string.Empty, DashLine.N(withAttachments)));
        }
        long trash = allFolders.FirstOrDefault(f => f.Name == "Trash")?.Count ?? 0;
        if (trash > 0)
        {
            healthLines.Add(new DashLine("trash", "{n} messages in Trash, emptied after their time", string.Empty, "/folder/Trash", string.Empty, DashLine.N(trash)));
        }
        health = healthLines;

        // Your safety: devices, refused sign-ins today, dangerous mail caught today.
        var safe = new List<DashLine>();
        if (box.Id == person)
        {
            IReadOnlyList<SessionRecord> devices = await Sessions.ListAsync(person, SessionRegistry.SessionOf(user));
            safe.Add(new DashLine("mobile-app", devices.Count == 1 ? "1 device signed in" : "{n} devices signed in",
                devices.Count(d => d.Shared) > 0 ? "{shared} on a shared computer" : string.Empty, "/settings/security", string.Empty,
                new Dictionary<string, string>(StringComparer.Ordinal) { ["n"] = devices.Count.ToString(Inv), ["shared"] = devices.Count(d => d.Shared).ToString(Inv) }));
            int failed = await Mail.FailedSignInsAsync(new[] { box.Address, box.LocalPart }, MailboxService.DashPeriodOf("today", clock, now).Start);
            safe.Add(new DashLine("security", failed == 0 ? "No refused sign-ins today" : failed == 1 ? "1 refused sign-in today" : "{n} refused sign-ins today",
                failed > 0 ? "If it was not you, change your password" : string.Empty, "/settings/security", failed > 0 ? "warn" : string.Empty, DashLine.N(failed)));
        }
        // rc.15 (item 58): mail the person rescued from Junk with "Not spam".
        IReadOnlyList<RescuedMessage> rescued = await Mail.RescuedSinceAsync(box.Id, now.AddDays(-30));
        safe.Add(new DashLine("email", rescued.Count == 0 ? "Nothing rescued from Junk in the last 30 days" : rescued.Count == 1 ? "1 message rescued from Junk in the last 30 days" : "{n} messages rescued from Junk in the last 30 days",
            rescued.Count > 0 ? "Marked Not spam by you; their senders now reach your Inbox" : string.Empty, rescued.Count > 0 ? "/search?scope=all&rescued=30" : string.Empty, string.Empty, DashLine.N(rescued.Count)));
        MailFigures today = table[0].Figures;
        long dangerous = today.Scores.Skip(8).Sum();
        safe.Add(new DashLine("circle-x", dangerous == 0 ? "No dangerous mail caught today" : dangerous == 1 ? "1 dangerous message caught today" : "{n} dangerous messages caught today",
            dangerous > 0 ? "Score 8 or more, filed in Junk" : string.Empty, dangerous > 0 ? "/folder/Junk" : string.Empty, dangerous > 0 ? "bad" : string.Empty, DashLine.N(dangerous)));
        safety = safe;

        space = (await Mail.FolderSpaceAsync(box.Id)).Take(8).Select(f => (L.Folder(f.Folder), f.Bytes, (string?)("/folder/" + Uri.EscapeDataString(f.Folder)), 0)).ToList();
        personId = person;
        if (box.Id == person)
        {
            habitsOn = (await Mail.GetMailSettingsAsync(person)).Habits;
            habits = habitsOn ? await Mail.HabitsAsync(person, clock, now) : null;
        }
        loaded = true;
    }
}
