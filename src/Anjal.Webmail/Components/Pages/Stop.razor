@page "/unavailable"
@attribute [AllowAnonymous]
@layout MainLayout
@inject Words Words
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http

<PageTitle>@L["Mailbox unavailable"] — Anjal</PageTitle>

<div class="centre">
    <div class="panel signin">
        <h1 style="font-family:var(--font-display);font-size:20px;margin:0 0 8px">@L["Mailbox unavailable"]</h1>
        <p style="font-size:14px;color:var(--ink-muted);margin:0 0 14px">
            @L["This account has been suspended. Mail sent to it is being held by the sending servers and retried, not rejected. Your administrator can restore it."]
        </p>
        <a class="btn btn-s" href="/sign-in">@L["Back to sign in"]</a>
    </div>
</div>

@code {
    // rc.15 (item 41): this page too speaks the reader's language.
    private Lexicon L = new("en", new Dictionary<string, string>());

    protected override void OnInitialized() => L = AuthWords.For(Http.HttpContext, Words);
}
