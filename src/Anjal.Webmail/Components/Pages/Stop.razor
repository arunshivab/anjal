@page "/unavailable"
@attribute [AllowAnonymous]
@layout MainLayout

<PageTitle>Mailbox unavailable — Anjal</PageTitle>

<div class="centre">
    <div class="panel signin">
        <h1 style="font-family:var(--font-display);font-size:20px;margin:0 0 8px">Mailbox unavailable</h1>
        <p style="font-size:14px;color:var(--ink-muted);margin:0 0 14px">
            This account has been suspended. Mail sent to it is being held by the sending servers and retried, not rejected.
            Your administrator can restore it.
        </p>
        <a class="btn btn-s" href="/sign-in">Back to sign in</a>
    </div>
</div>
