@page "/message/{Id:guid}"
@attribute [Authorize]

<MessageReader Id="Id" Images="@Images" Blocked="@Blocked" Preview="@PreviewIndex" ShowBack="true" ReturnTo="@SafeReturn" />

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "images")] private string? Images { get; set; }
    [SupplyParameterFromQuery(Name = "blocked")] private string? Blocked { get; set; }
    [SupplyParameterFromQuery(Name = "preview")] private string? PreviewText { get; set; }

    [SupplyParameterFromQuery(Name = "back")] private string? BackText { get; set; }

    // rc.15: the list it was opened from (a double click), kept to Anjal's own folder and search pages.
    private string? SafeReturn => BackText is string b && (b.StartsWith("/folder/", StringComparison.Ordinal) || b.StartsWith("/search", StringComparison.Ordinal) || b == "/no-reply")
        && !b.Contains("//", StringComparison.Ordinal) && !b.Contains('\\', StringComparison.Ordinal) ? b : null;

    private int? PreviewIndex => int.TryParse(PreviewText, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out int i) ? i : null;
}
