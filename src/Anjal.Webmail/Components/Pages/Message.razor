@page "/message/{Id:guid}"
@attribute [Authorize]
@inject MailboxService Mail

<PageTitle>@(view?.Subject ?? "Message") — Anjal</PageTitle>

@if (view is null)
{
    <div class="stack">
        <h1>That message is no longer here.</h1>
        <p class="lead">It may have been deleted, or moved to another folder. The folder it was in is still there.</p>
        <a class="btn btn-s" href="/folder/INBOX">Back to INBOX</a>
    </div>
}
else
{
    <div class="reading">
        <main class="read">
            <div class="tb">
                <a class="back inrow" href="/folder/@Uri.EscapeDataString(view.Folder.Name)"
                   title="Back to @view.Folder.Name">
                    <LipiIcon Name="chevron-left" Size="16" />
                </a>
                <a class="btn btn-p" href="/compose?reply=@Id"><LipiIcon Name="undo" Size="15" /> Reply</a>
                <a class="btn btn-s" href="/compose?replyall=@Id">Reply all</a>
                <a class="btn btn-s" href="/compose?forward=@Id"><LipiIcon Name="redo" Size="15" /> Forward</a>
                <span class="gap"></span>

                <form method="post" action="/message/@Id/flag" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="back" value="/message/@Id" />
                    <button type="submit" class="btn btn-q">@(view.Row.Flagged ? "Unflag" : "Flag")</button>
                </form>
                <form method="post" action="/message/@Id/read" class="inline">
                    <AntiforgeryToken />
                    <input type="hidden" name="seen" value="0" />
                    <input type="hidden" name="back" value="/folder/@Uri.EscapeDataString(view.Folder.Name)" />
                    <button type="submit" class="btn btn-q">Mark unread</button>
                </form>

                @if (view.Folder.Name == Anjal.Mailbox.MailboxSink.JunkFolder)
                {
                    <form method="post" action="/message/@Id/move" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="folder" value="INBOX" />
                        <input type="hidden" name="allow" value="1" />
                        <input type="hidden" name="back" value="/folder/INBOX" />
                        <button type="submit" class="btn btn-s">Not spam</button>
                    </form>
                }
                else if (view.Folder.Name != "Trash" && view.Folder.Name != "Sent")
                {
                    <form method="post" action="/message/@Id/move" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="folder" value="Junk" />
                        <input type="hidden" name="block" value="1" />
                        <input type="hidden" name="back" value="/folder/@Uri.EscapeDataString(view.Folder.Name)" />
                        <button type="submit" class="btn btn-q">Report spam</button>
                    </form>
                }

                @if (view.Folder.Name == "Trash")
                {
                    <form method="post" action="/message/@Id/move" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="folder" value="INBOX" />
                        <input type="hidden" name="back" value="/folder/INBOX" />
                        <button type="submit" class="btn btn-q">Restore</button>
                    </form>
                }
                else
                {
                    <form method="post" action="/message/@Id/move" class="inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="folder" value="Trash" />
                        <input type="hidden" name="back" value="/folder/@Uri.EscapeDataString(view.Folder.Name)" />
                        <button type="submit" class="btn btn-q"><LipiIcon Name="trash" Size="15" /> Trash</button>
                    </form>
                }
            </div>

            <h1 class="readsubj">@(string.IsNullOrWhiteSpace(view.Subject) ? "(no subject)" : view.Subject)</h1>
            @if (view.Row.CategoryId is Guid currentCat && categories.FirstOrDefault(c => c.Row.Id == currentCat) is CategoryView shown)
            {
                <p class="readcat"><span class="chip slot-@shown.Row.Slot"><i></i>@shown.Row.Name</span></p>
            }
            <p class="byline">
                <span class="seal" aria-hidden="true">@Initial</span>
                <span><b>@SenderName</b><span class="sep">·</span>@view.Date</span>
            </p>

            @if (view.HasBlockedImages)
            {
                <div class="notice n-info readnotice">
                    <LipiIcon Name="info" Size="16" />
                    <span>Remote images were blocked. They can tell the sender that you opened this message.</span>
                    <form method="post" action="/message/@Id/images" class="inline act">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-s btn-sm">Load images</button>
                    </form>
                </div>
            }
            @if (view.Folder.Name == Anjal.Mailbox.MailboxSink.JunkFolder)
            {
                <div class="notice n-info readnotice">
                    <LipiIcon Name="info" Size="16" />
                    <span>Anjal accepted this message and filed it in Junk. It was never rejected.
                          Choosing <b>Not spam</b> moves it to INBOX and allows the sender.</span>
                </div>
            }

            <div class="bodypanel">
                <iframe class="bodyframe" sandbox="" referrerpolicy="no-referrer" title="Message body" srcdoc="@Srcdoc"></iframe>
            </div>
        </main>

        <aside class="rail" aria-label="Message details">
            <section class="railcard">
                <h2 class="railhead">Details</h2>
                <dl class="raildl">
                    <dt>From</dt>
                    @if (string.IsNullOrWhiteSpace(view.From))
                    {
                        @* No From header: show who actually sent it, and say so (DEF-022). *@
                        <dd>@(string.IsNullOrWhiteSpace(view.Row.EnvelopeFrom) ? "(unknown)" : view.Row.EnvelopeFrom)
                            <span class="railnote">envelope sender; the message has no From header</span></dd>
                    }
                    else
                    {
                        <dd>@view.From</dd>
                    }
                    <dt>To</dt><dd>@view.To</dd>
                    @if (view.Cc.Length > 0)
                    {
                        <dt>Cc</dt><dd>@view.Cc</dd>
                    }
                    <dt>Date</dt><dd>@view.Date</dd>
                    <dt>Folder</dt><dd>@view.Folder.Name</dd>
                    <dt>Size</dt><dd>@MainLayout.Size(view.Row.SizeBytes)</dd>
                </dl>
            </section>

            @if (view.Attachments.Count > 0)
            {
                <section class="railcard">
                    <h2 class="railhead">@view.Attachments.Count attachment@(view.Attachments.Count == 1 ? "" : "s")</h2>
                    @foreach (AttachmentView a in view.Attachments)
                    {
                        <a class="attrow" href="/message/@Id/attachment/@a.Index">
                            <LipiIcon Name="attachment" Size="16" />
                            <span>
                                <span class="fn">@a.FileName</span>
                                <span class="mt">@MainLayout.Size(a.SizeBytes)</span>
                            </span>
                            <LipiIcon Name="download" Size="15" Class="dlic" />
                        </a>
                    }
                </section>
            }

            <section class="railcard">
                <h2 class="railhead">Checks</h2>
                @* A message carrying this server's own verdicts was checked on arrival, whatever its stored flag says. *@
                @if (view.Auth is null && !Anjal.Webmail.Services.SpamCheck.WasChecked(view.Row, view.Folder.Name))
                {
                    <p class="railnote">@Anjal.Webmail.Services.SpamCheck.NotCheckedNote(view.Folder.Name)</p>
                }
                else if (view.Row.SpamScore > 0)
                {
                    <p class="scoreline @(view.Row.SpamScore >= 5 ? "hi" : "")">score @view.Row.SpamScore</p>
                    @if (view.SpamReasons.Length > 0)
                    {
                        <p class="railnote">@view.SpamReasons</p>
                    }
                }
                else
                {
                    <p class="railnote"><LipiIcon Name="check" Size="14" /> Nothing suspicious. Spam score 0.</p>
                }
                @* The sender checks this server made on arrival - never a sender's own claim (DEF-038). *@
                @if (view.Auth is AuthVerdicts av)
                {
                    <p class="authline">
                        <span class="av av-@AuthVerdicts.Tone(av.Spf)" title="Sender Policy Framework">SPF @av.Spf</span>
                        <span class="av av-@AuthVerdicts.Tone(av.Dkim)" title="DomainKeys Identified Mail">DKIM @av.Dkim</span>
                        <span class="av av-@AuthVerdicts.Tone(av.Dmarc)" title="Domain-based Message Authentication">DMARC @av.Dmarc</span>
                    </p>
                    @if (AuthVerdicts.DmarcMeaning(av.Dmarc) is string meaning && meaning.Length > 0)
                    {
                        <p class="railnote @(av.Dmarc == "fail" ? "avwarn" : null)">
                            @if (av.Dmarc == "fail")
                            {
                                <LipiIcon Name="warning" Size="14" />
                            }
                            @meaning
                        </p>
                    }
                }
                else if (Anjal.Webmail.Services.SpamCheck.WasChecked(view.Row, view.Folder.Name))
                {
                    <p class="railnote">Sender checks: not recorded for this message.</p>
                }
                @if (view.BodyShortened)
                {
                    <p class="railnote avwarn"><LipiIcon Name="warning" Size="14" /> This message was too large to show in full, so what you see has been cut short. Download the original to read all of it.</p>
                }
                <p class="railnote"><LipiIcon Name="security" Size="14" /> Shown in a sandbox; scripts cannot run.</p>
            </section>

            @* Category is for mail you keep: not offered in Junk or Trash. *@
            @if (view.Folder.Name != Anjal.Mailbox.MailboxSink.JunkFolder && view.Folder.Name != "Trash")
            {
                <section class="railcard">
                    <h2 class="railhead">Category</h2>
                    <form method="post" action="/message/@Id/category">
                        <AntiforgeryToken />
                        <input type="hidden" name="back" value="/message/@Id" />
                        <select class="railinp" name="categoryId" aria-label="Category">
                            <option value="">@MailboxService.Uncategorised</option>
                            @foreach (CategoryView c in categories)
                            {
                                <option value="@c.Row.Id" selected="@(view.Row.CategoryId == c.Row.Id)">
                                    @c.Row.Name@(c.Shared ? "" : " (yours)")
                                </option>
                            }
                        </select>
                        <label class="checkline">
                            <input type="checkbox" name="future" value="1" />
                            <span>Also file future mail from @SenderName here</span>
                        </label>
                        <button type="submit" class="btn btn-s railbtn">Save category</button>
                    </form>
                </section>

            }
            <section class="railcard">
                <h2 class="railhead">This message</h2>
                <a class="raillink" href="/message/@Id/raw.eml"><LipiIcon Name="download" Size="15" /> Download .eml</a>
                @if (view.Folder.Name == "Trash" || view.Folder.Name == Anjal.Mailbox.MailboxSink.JunkFolder)
                {
                    <details class="confirm">
                        <summary class="raillink danger"><LipiIcon Name="trash" Size="15" /> Delete permanently</summary>
                        <span class="inner">
                            This cannot be undone.
                            <form method="post" action="/message/@Id/delete" class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="back" value="/folder/@Uri.EscapeDataString(view.Folder.Name)" />
                                <button type="submit" class="btn btn-d btn-sm">Delete</button>
                            </form>
                        </span>
                    </details>
                }
            </section>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery(Name = "images")] private string? Images { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [CascadingParameter] private HttpContext? Http { get; set; }

    private MessageView? view;
    private IReadOnlyList<CategoryView> categories = System.Array.Empty<CategoryView>();

    private string SenderName
    {
        get
        {
            var parsed = Anjal.Mime.AddressParser.Parse(view?.From ?? string.Empty);
            if (parsed.Count > 0 && parsed[0].DisplayName.Length > 0)
            {
                return parsed[0].DisplayName;
            }
            return parsed.Count > 0 ? parsed[0].Address : (view?.From ?? string.Empty);
        }
    }

    /// <summary>First letter of the sender, for the seal beside the byline.</summary>
    private string Initial
    {
        get
        {
            string name = SenderName.TrimStart();
            return name.Length > 0 ? name.Substring(0, 1).ToUpperInvariant() : "?";
        }
    }

    /// <summary>
    /// The frame's own content security policy. It allows nothing to load
    /// except inline images, until the reader chooses Load images, and even
    /// then only images. Scripts are already impossible (sandbox=""); this
    /// closes the remaining channels - stylesheets, fonts, media - that could
    /// otherwise report an open back to a sender.
    /// </summary>
    private string FrameCsp =>
        "default-src 'none'; style-src 'unsafe-inline'; font-src data:" + (FontOrigin is string o ? " " + o : string.Empty) +
        "; img-src data:" + (Images == "1" ? " https: http:" : string.Empty);

    /// <summary>
    /// This server's own address, for loading LiPi Sans into the frame
    /// (DEF-021). The frame may fetch fonts from here and nowhere else. The
    /// value comes from the request's Host header, so it is used only when
    /// it is made of host-name characters; otherwise the frame keeps the
    /// system font.
    /// </summary>
    private string? FontOrigin
    {
        get
        {
            if (Http is null)
            {
                return null;
            }
            string host = Http.Request.Host.Value ?? string.Empty;
            string scheme = Http.Request.Scheme;
            bool safe = host.Length > 0 && host.Length <= 255 && (scheme == "https" || scheme == "http") &&
                host.All(c => char.IsAsciiLetterOrDigit(c) || c == '.' || c == '-' || c == ':' || c == '[' || c == ']');
            return safe ? $"{scheme}://{host}" : null;
        }
    }

    /// <summary>LiPi Sans's @font-face rules with absolute addresses, or nothing.</summary>
    private string FontFaces => FontOrigin is string origin ? Services.FrameFonts.FaceRules(origin) : string.Empty;

    private string Srcdoc =>
        "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"referrer\" content=\"no-referrer\">" +
        "<meta http-equiv=\"Content-Security-Policy\" content=\"" + FrameCsp + "\">" +
        "<style>" + FontFaces + "body{font-family:'LiPi Sans',system-ui,-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;" +
        "margin:18px;color:#1a1a1a;background:#fff;word-wrap:break-word}img{max-width:100%}" +
        "pre{white-space:pre-wrap;font-family:inherit;margin:0}a{color:#0b5d8f}</style></head><body>" +
        (view?.BodyHtml ?? string.Empty) + "</body></html>";

    protected override async Task OnParametersSetAsync()
    {
        view = null;
        if (AuthState is null)
        {
            return;
        }
        Guid? mailboxId = WebmailAuthService.MailboxIdOf((await AuthState).User);
        if (mailboxId is null)
        {
            return;
        }
        view = await Mail.OpenAsync(mailboxId.Value, Id, allowRemoteImages: Images == "1");
        if (view is null && Http is not null)
        {
            // The friendly page stays; the status says what happened (DEF-013).
            // Set as the headers go out: a 404 set during rendering makes
            // Blazor discard the page and send an empty body.
            HttpContext http = Http;
            http.Response.OnStarting(() =>
            {
                http.Response.StatusCode = StatusCodes.Status404NotFound;
                return Task.CompletedTask;
            });
        }
        categories = await Mail.ListCategoriesAsync(mailboxId.Value);
    }
}
