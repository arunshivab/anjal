@* rc.13 (AuthReset, AuthInvite, SetSecurity): the password rules beside a new
   password, ticked as the person types. The script asks the server, so the
   list is the same rules the server will apply; without the script the rules
   still read as a list, and the server says what is wrong on saving. *@
<ul class="pwrules" data-pwrules data-for="@For" aria-live="polite">
    @foreach ((string key, string word) in Rules)
    {
        <li data-rule="@key" class="@(Failed.Contains(key) ? "bad" : null)">
            <span class="pw-ico pw-wait" aria-hidden="true"><LipiIcon Name="circle" Size="15" /></span>
            <span class="pw-ico pw-ok" aria-hidden="true"><LipiIcon Name="check" Size="15" /></span>
            <span class="pw-ico pw-no" aria-hidden="true"><LipiIcon Name="close" Size="15" /></span>
            <span>@L[word].Replace("{n}", (key == "history" ? History : MinLength).ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)</span>
        </li>
    }
</ul>
@if (Note is not null)
{
    <p class="authhint pwnote">@Note</p>
}

@code {
    /// <summary>The id of the password field the list watches.</summary>
    [Parameter] public string For { get; set; } = "password";

    /// <summary>The page's words.</summary>
    [Parameter] public Lexicon L { get; set; } = new("en", new Dictionary<string, string>());

    /// <summary>
    /// How many earlier passwords the organisation refuses: 0 (the default, not listed), 3 or 5
    /// (owner, 10 Oct 2026, P8). Not for a first password.
    /// </summary>
    [Parameter] public int History { get; set; }

    /// <summary>Rules the server refused on the last save, shown crossed.</summary>
    [Parameter] public IReadOnlyCollection<string> Failed { get; set; } = Array.Empty<string>();

    /// <summary>The person's shortest password: 15, or 12 with two-step, or the organisation's if longer (owner, 10 Oct 2026).</summary>
    [Parameter] public int MinLength { get; set; } = Anjal.Smtp.PasswordPolicy.AloneLength;

    /// <summary>A line under the list.</summary>
    [Parameter] public string? Note { get; set; }

    private IEnumerable<(string Key, string Word)> Rules
    {
        get
        {
            // Owner, 10 Oct 2026: no rule about kinds of characters (P2); the three below are all.
            yield return ("length", "At least {n} characters");
            yield return ("common", "Not a known leaked password or a common word");
            if (History > 0)
            {
                yield return ("history", "Not one of your last {n}");
            }
            yield return ("personal", "Not mostly your name or address");
        }
    }
}
