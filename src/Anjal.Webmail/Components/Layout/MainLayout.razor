    private string DisplayName => person is null || person.DisplayName.Length == 0 ? string.Empty : person.DisplayName;

    /// <summary>The person's initials for the phone's top bar (the board's "AS"); the address's first letter when there is no name.</summary>
    private string Initials
    {
        get
        {
            string[] parts = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0)
            {
                string address = person?.Address ?? "?";
                return address.Length > 0 ? address[..1].ToUpperInvariant() : "?";
            }
            string first = parts[0][..1];
            string last = parts.Length > 1 ? parts[^1][..1] : string.Empty;
            return (first + last).ToUpperInvariant();
        }
    }

