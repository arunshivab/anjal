@inherits LayoutComponentBase
@inject MailboxService Mail
@inject NavigationManager Nav
@inject Words Words
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http

@if (AuthPage)
{
    @* rc.13: the sign-in, reset, invitation and signed-out pages stand alone,
       even for someone already signed in (an invitation opened in a signed-in browser). *@
    <div class="frame">
        <main class="pane" id="main"><CascadingValue Value="this" IsFixed="true">@Body</CascadingValue></main>
    </div>
}
else
{
<AuthorizeView>
    <Authorized>
        <div class="@FrameClass" data-offline-mail="@(offlineMail ? "on" : "off")" data-offline-words="@(offlineMail ? OfflineWords : null)">
            <a class="skip" href="#main">@L["Skip to content"]</a>
            <div class="frame-body">
                <nav class="rail @(Folded ? "folded" : RailAuto ? "auto" : "")" aria-label="@L["Folders"]">
                    <div class="rail-head">
                    <a class="rail-mark" href="/folder/INBOX" aria-label="@L["Anjal, go to inbox"]">
                        <span class="mark-tile" aria-hidden="true">
                            <svg viewBox="0 0 148 148" width="34" height="34"><rect width="148" height="148" rx="34" class="mt-tile"></rect><path d="M18 30 L74 78 L130 30" class="mt-flap"></path></svg>
                            <span class="mt-letter" lang="@L.Language">@Words.MarkLetter(L.Language)</span>
                        </span>
                        <span class="rl rail-name">Anjal</span>
                    </a>
                        <form method="post" action="/settings/rail" class="rail-fold">
                        <AntiforgeryToken />
                        <input type="hidden" name="back" value="@BackPath" />
                        @* Until the person chooses, the rail folds itself up to laptop width; both buttons are drawn and the screen's width decides which shows. *@
                        @if (Folded || RailAuto)
                        {
                            <button type="submit" name="folded" value="0" class="rail-item rf-open" title="@L["Show folder names"]" aria-label="@L["Show folder names"]"><LipiIcon Name="chevrons-right" Size="18" /></button>
                        }
                        @if (!Folded)
                        {
                            <button type="submit" name="folded" value="1" class="rail-item rf-fold" title="@L["Show icons only"]" aria-label="@L["Show icons only"]"><LipiIcon Name="chevrons-left" Size="18" /></button>
                        }
                    </form>
                    </div>
                    <div class="rail-composewrap">
                        <a class="rail-compose" href="/compose" title="@L["Compose"]"><LipiIcon Name="edit" Size="18" /><span class="rl">@L["Compose"]</span></a>
                        @* rc.15 (item 62, owner 7 Oct): the Compose button's arrow - start from a template, or in the small window.
                           rc.15.1 (DEF-095): not while a sign-in step is pending; nothing is written until it is done. *@
                        @if (signInDemand is null)
                        {
                        <details class="pmenu composemore">
                            <summary class="composearrow" title="@L["More ways to write"]" aria-label="@L["More ways to write"]"><LipiIcon Name="chevron-down" Size="12" /></summary>
                            <div class="pmenu-body">
                                <form method="post" action="/draft" enctype="multipart/form-data" class="inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="to" value="" />
                                    <button type="submit" class="pmi" name="templates" value="1" data-needs-server><LipiIcon Name="email-template" Size="15" />@L["From a template"]</button>
                                </form>
                                <form method="post" action="/draft" enctype="multipart/form-data" class="inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="to" value="" />
                                    <input type="hidden" name="back" value="/folder/INBOX" />
                                    <button type="submit" class="pmi" name="dock" value="1" data-needs-server><LipiIcon Name="collapse" Size="15" />@L["Small window"]</button>
                                </form>
                            </div>
                        </details>
                        }
                    </div>
                    @* rc.16, design review 8 (owner, 11 Oct 2026): Today, the landing page, sits above Inbox. *@
                    <a class="rail-item @(OnPath("/dashboard/today") ? "on" : "")" href="/dashboard/today" title="@L["Today"]" aria-current="@(OnPath("/dashboard/today") ? "page" : null)"><LipiIcon Name="home" Size="18" /><span class="rl">@L["Today"]</span></a>
                    @if (folders is not null)
                    {
                        @foreach (FolderView f in folders)
                        {
                            @if (f.Name == MailboxService.SnoozedFolder && f.Count == 0 && !IsCurrent(f.Name))
                            {
                                @* rc.22 (item 31): Snoozed shows only while something sleeps in it. *@
                                continue;
                            }
                            <a class="rail-item @(IsCurrent(f.Name) ? "on" : "")" href="/folder/@Uri.EscapeDataString(f.Name)" title="@L.Folder(f.Name)" aria-current="@(IsCurrent(f.Name) ? "page" : null)">
                                <LipiIcon Name="@IconFor(f.Name)" Size="18" />
                                <span class="rl">@L.Folder(f.Name)</span>
                                @if (Badge(f) is string badge)
                                {
                                    <span class="n @(f.Name == FolderRow.Inbox && f.Unread > 0 ? "unreadn" : "")"
                                          data-unread-badge="@(f.Name == FolderRow.Inbox ? "1" : null)">@badge</span>
                                }
                            </a>
                            @if (f.Name == MailboxService.ScheduledFolder)
                            {
                                @* rc.12 (item 9): the Outbox - mail still being delivered - after Scheduled. *@
                                <a class="rail-item @(OnOutbox ? "on" : "")" href="/outbox" title="@L["Outbox"]" aria-current="@(OnOutbox ? "page" : null)">
                                    <LipiIcon Name="upload" Size="18" />
                                    <span class="rl">@L["Outbox"]</span>
                                    @if (outboxCount > 0)
                                    {
                                        <span class="n">@outboxCount</span>
                                    }
                                </a>
                            }
                        }
                    }
                    @if (sharedBoxes.Count > 0)
                    {
                        @* rc.14 (board OrgShared): shared mailboxes open beside the person's own. *@
                        <span class="rail-group rl">@L["Shared mailboxes"]</span>
                        @foreach ((MailboxRow box, string right, long unread) in sharedBoxes)
                        {
                            <form method="post" action="/shared/open" class="rail-form">
                                <AntiforgeryToken />
                                <input type="hidden" name="id" value="@box.Id" />
                                <button type="submit" class="rail-item @(acting?.Id == box.Id ? "on" : "")" title="@box.Address" aria-current="@(acting?.Id == box.Id ? "true" : null)">
                                    <LipiIcon Name="users" Size="18" />
                                    <span class="rl">@(box.DisplayName.Length > 0 ? box.DisplayName : box.LocalPart)</span>
                                    @if (unread > 0)
                                    {
                                        <span class="n">@unread</span>
                                    }
                                </button>
                            </form>
                        }
                    }
                    @* Design review 5: Contacts is used daily, so it sits with the mail, with its own icon. *@
                    <a class="rail-item @(Nav.Uri.Contains("/contacts", StringComparison.OrdinalIgnoreCase) ? "on" : "")" href="/contacts" title="@L["Contacts"]"><LipiIcon Name="user" Size="18" /><span class="rl">@L["Contacts"]</span></a>
                    <span class="rail-gap"></span>
                    <a class="rail-item @(OnPath("/dashboard") && !OnPath("/dashboard/today") ? "on" : "")" href="/dashboard" title="@L["Dashboard"]"><LipiIcon Name="chart-bar" Size="18" /><span class="rl">@L["Dashboard"]</span></a>
                    @if (isAdmin)
                    {
                        <a class="rail-item @(OnPath("/org") ? "on" : "")" href="/org" title="@L["Organisation"]"><LipiIcon Name="department-master" Size="18" /><span class="rl">@L["Organisation"]</span></a>
                    }
                    @if (isOperator)
                    {
                        <a class="rail-item @(OnPath("/ops") ? "on" : "")" href="/ops" title="@L["Anjal console"]"><LipiIcon Name="monitoring" Size="18" /><span class="rl">@L["Anjal console"]</span></a>
                    }
                    <a class="rail-item @(OnPath("/settings") ? "on" : "")" href="/settings" title="@L["Settings"]"><LipiIcon Name="sliders" Size="18" /><span class="rl">@L["Settings"]</span></a>
                    @* Design review 4.5: the account menu under the initials holds who is signed in, the
                       last sign-in, the date and Sign out; Help left the rail, "?" opens it. *@
                    <details class="pmenu rail-account">
                        <summary class="rail-item rail-me" title="@DisplayName" aria-label="@L["Your account"]"><span class="initials" aria-hidden="true">@Initials</span><span class="rl">@DisplayName</span></summary>
                        <div class="pmenu-body accountmenu" role="menu">
                            <p class="acct-who"><b>@DisplayName</b><span>@context.User.Identity?.Name</span></p>
                            @if (lastSignIn is not null)
                            {
                                <a class="pmi st-last" role="menuitem" href="/settings/security" title="@L["Your sign-in before this one, from {device}. Not you? Open Security to sign other devices out."].Replace("{device}", lastSignIn.Device, StringComparison.Ordinal)"><LipiIcon Name="clock" Size="15" />@LastSignInText</a>
                            }
                            @* rc.22 (item 33, mockup 10): the other accounts signed in on this browser, and switching. *@
                            @if (!Shared && otherAccounts.Count > 0)
                            {
                                <p class="pm-head">@L["Switch to"]</p>
                                @foreach ((MailboxRow other, long unread) in otherAccounts)
                                {
                                    <form method="post" action="/auth/switch" class="inline acct-switch">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="to" value="@other.Id" />
                                        <input type="hidden" name="back" value="/folder/INBOX" />
                                        <button type="submit" class="pmi" role="menuitem" title="@other.Address"><span class="initials acct-initials" aria-hidden="true">@InitialsOf(other)</span><span class="acct-addr">@other.Address</span>@if (unread > 0) {<span class="pill pill-info acct-unread">@(unread == 1 ? L["1 new"] : L["{n} new"].Replace("{n}", unread.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal))</span>}</button>
                                    </form>
                                }
                            }
                            @if (!Shared && otherAccounts.Count < AuthEndpoints.MaxAccounts)
                            {
                                <a class="pmi" role="menuitem" href="/sign-in?add=1"><LipiIcon Name="plus" Size="15" />@L["Add another account"]</a>
                            }
                            <span class="acct-date"><LipiIcon Name="calendar" Size="15" />@clock.Full(now)</span>
                            @if (Shared)
                            {
                                <span class="acct-date st-shared"><LipiIcon Name="lock" Size="15" />@L["Shared computer"]</span>
                            }
                            <form method="post" action="/sign-out" class="inline signout">
                                <AntiforgeryToken />
                                <button type="submit" class="st-signout" role="menuitem"><LipiIcon Name="log-out" Size="15" />@(otherAccounts.Count > 0 ? L["Sign out of this account"] : L["Sign out"])</button>
                            </form>
                            @if (!Shared && otherAccounts.Count > 0)
                            {
                                <form method="post" action="/sign-out" class="inline signout">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="all" value="1" />
                                    <button type="submit" class="st-signout" role="menuitem"><LipiIcon Name="log-out" Size="15" />@(otherAccounts.Count == 1 ? L["Sign out of both"] : L["Sign out of all {n}"].Replace("{n}", (otherAccounts.Count + 1).ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal))</button>
                                </form>
                            }
                        </div>
                    </details>
                </nav>
                <main class="pane" id="main">
                    <CascadingValue Value="this" IsFixed="true">@Body</CascadingValue>
                </main>
            </div>
            @* The phone (A11, the approved boards): a top bar, a bottom bar with Compose
               in the middle, and the folders sheet with the account and Sign out.
               Shown only on narrow screens; both sheets open without the script. *@
            <header class="phonetop">
                <a class="rail-mark" href="/folder/INBOX" aria-label="@L["Anjal, go to inbox"]">
                    <span class="mark-tile" aria-hidden="true">
                        <svg viewBox="0 0 148 148" width="30" height="30"><rect width="148" height="148" rx="34" class="mt-tile"></rect><path d="M18 30 L74 78 L130 30" class="mt-flap"></path></svg>
                        <span class="mt-letter" lang="@L.Language">@Words.MarkLetter(L.Language)</span>
                    </span>
                </a>
                <span class="lh-grow"></span>
                <a class="initials" href="#folders" aria-label="@L["Your account"]" title="@DisplayName">@Initials</a>
            </header>
            @* rc.16, design review 5 and 8 [5d]: the phone's bar is Today, Inbox, Compose, Search and More;
               More opens the sheet with the folders, Dashboard, Settings and the account. *@
            <nav class="phonenav" aria-label="@L["Main"]">
                <a href="/dashboard/today" class="@(OnPath("/dashboard/today") ? "on" : "")"><LipiIcon Name="home" Size="20" /><span>@L["Today"]</span></a>
                <a href="/folder/INBOX" class="@(IsCurrent(FolderRow.Inbox) ? "on" : "")"><LipiIcon Name="email" Size="20" /><span>@L["Inbox"]</span></a>
                <a href="/compose" class="pcompose" aria-label="@L["Compose"]"><LipiIcon Name="edit" Size="22" /></a>
                <a href="/search?scope=all" class="@(OnPath("/search") ? "on" : "")"><LipiIcon Name="search" Size="20" /><span>@L["Search"]</span></a>
                <a href="#folders"><LipiIcon Name="more-horizontal" Size="20" /><span>@L["More"]</span></a>
            </nav>
            <div id="folders" class="phonesheet" role="dialog" aria-modal="true" aria-label="@L["Folders"]">
                <div class="psheet">
                    <div class="pshead"><b>@L["Folders"]</b><span class="lh-grow"></span><a class="iconbtn" href="#close" aria-label="@L["Close"]"><LipiIcon Name="close" Size="17" /></a></div>
                    <div class="paccount">
                        <span class="initials">@Initials</span>
                        <span class="pwho"><b>@DisplayName</b><span>@context.User.Identity?.Name</span></span>
                        <form method="post" action="/sign-out" class="inline"><AntiforgeryToken /><button type="submit" class="st-signout">@L["Sign out"]</button></form>
                    </div>
                    @if (folders is not null)
                    {
                        @foreach (FolderView f in folders.Where(f => MailboxService.DefaultFolders.Contains(f.Name)))
                        {
                            <a class="pfolder" href="/folder/@Uri.EscapeDataString(f.Name)"><LipiIcon Name="@IconFor(f.Name)" Size="18" /><span>@L.Folder(f.Name)</span>@if (Badge(f) is string pb) { <span class="n">@pb</span> }</a>
                        }
                        @if (folders.Any(f => !MailboxService.DefaultFolders.Contains(f.Name)))
                        {
                            <span class="pgroup">@L["Your folders"]</span>
                            @foreach (FolderView f in folders.Where(f => !MailboxService.DefaultFolders.Contains(f.Name)))
                            {
                                <a class="pfolder" href="/folder/@Uri.EscapeDataString(f.Name)"><LipiIcon Name="folder" Size="18" /><span>@f.Name</span>@if (Badge(f) is string ob) { <span class="n">@ob</span> }</a>
                            }
                        }
                    }
                    <a class="pfolder" href="/outbox"><LipiIcon Name="upload" Size="18" /><span>@L["Outbox"]</span>@if (outboxCount > 0) { <span class="n">@outboxCount</span> }</a>
                    <a class="pfolder" href="/contacts"><LipiIcon Name="user" Size="18" /><span>@L["Contacts"]</span></a>
                    <a class="pfolder" href="/dashboard"><LipiIcon Name="chart-bar" Size="18" /><span>@L["Dashboard"]</span></a>
                    <a class="pfolder" href="/settings"><LipiIcon Name="sliders" Size="18" /><span>@L["Settings"]</span></a>
                    @foreach ((MailboxRow box, string right, long unread) in sharedBoxes)
                    {
                        <form method="post" action="/shared/open" class="pfolder-form">
                            <AntiforgeryToken />
                            <input type="hidden" name="id" value="@box.Id" />
                            <button type="submit" class="pfolder"><LipiIcon Name="users" Size="18" /><span>@box.Address</span>@if (unread > 0) { <span class="n">@unread</span> }</button>
                        </form>
                    }
                    @if (isAdmin)
                    {
                        <a class="pfolder" href="/org"><LipiIcon Name="department-master" Size="18" /><span>@L["Organisation"]</span></a>
                    }
                    @* DEF-149a (rc.23): the operator reaches the Anjal console from a phone too. *@
                    @if (isOperator)
                    {
                        <a class="pfolder" href="/ops"><LipiIcon Name="monitoring" Size="18" /><span>@L["Anjal console"]</span></a>
                    }
                    <div class="pstatus">
                        <span class="lite" data-connectivity data-online="@L["Connected"]" data-offline="@L["Offline"]"><i></i><span class="slot" data-slot-a="@L["Connected"]" data-slot-b="@L["Offline"]">@L["Connected"]</span></span>
                        @if (mailbox is not null)
                        {
                            <span>@StorageText</span>
                        }
                    </div>
                </div>
            </div>
            @* Item 5 and D-105: the welcome screen, once; then the tour, or skip. *@
            @if (acting is not null)
            {
                @* rc.14: whose mail this is, always in view while a shared mailbox is open. *@
                <form method="post" action="/shared/close" class="actingbar" role="status">
                    <AntiforgeryToken />
                    <LipiIcon Name="users" Size="16" />
                    <span>@L["You are in {address}, with {right}."].Replace("{address}", acting.Address, StringComparison.Ordinal).Replace("{right}", L[RightWord(actingRight)], StringComparison.Ordinal)</span>
                    <button type="submit" class="linkbtn">@L["Back to my mailbox"]</button>
                </form>
            }
            @* rc.15.1 (DEF-095): never while a sign-in step is pending (a longer password, or
               two-step the organisation requires) - the person does that first, then is welcomed. *@
            @if (person is not null && !person.WelcomeDone && !OnTwoStepSetup && signInDemand is null)
            {
                <div class="welcome" role="dialog" aria-modal="true" aria-labelledby="welcometitle">
                    @* rc.16, design review [6j]: a brand header with the person's name, three cards, and a
                       four-step tour. *@
                    <div class="wcard">
                        <header class="whead">
                            <span class="mark-tile" aria-hidden="true"><svg viewBox="0 0 148 148" width="44" height="44"><rect width="148" height="148" rx="34" class="mt-tile"></rect><path d="M18 30 L74 78 L130 30" class="mt-flap"></path></svg></span>
                            <div>
                                <h2 id="welcometitle">@L["Welcome, {name}"].Replace("{name}", MailboxService.FirstName(person.DisplayName, person.Address), StringComparison.Ordinal)</h2>
                                <p>@L["Three things to know before you start."]</p>
                            </div>
                        </header>
                        <div class="wgrid">
                            @foreach ((string icon, string title, string text) in WelcomeCards)
                            {
                                <section class="wfeat"><span class="wicon"><LipiIcon Name="@icon" Size="20" /></span><h3>@L[title]</h3><p>@L[text]</p></section>
                            }
                        </div>
                        <p class="wlajna">@((MarkupString)LajnaMarkSvg.Small)<span>@L["Lajna, Anjal's helper, opens from Ask Lajna at the foot of the screen: ask it how to do something, to find your mail, or to write a draft."]</span></p>
                        <div class="wactions">
                            <form method="post" action="/settings/welcome" class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="tour" value="1" />
                                <button type="submit" class="btn btn-p">@L["Show me around · {n} steps"].Replace("{n}", "4", StringComparison.Ordinal)</button>
                            </form>
                            <form method="post" action="/settings/welcome" class="inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="back" value="@BackPath" />
                                <button type="submit" class="btn btn-q">@L["Skip"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            @* rc.18, design review section 11: Lajna - a button on every page and its panel. It reads only
               your own mail and settings, here in Anjal; it never sends or changes anything without your Yes.
               Without the script the button opens /lajna as a page. *@
            <a class="lajnabtn" href="/lajna?page=@Uri.EscapeDataString(PathNow)" data-lajna-open aria-controls="lajna" title="@L["Ask Lajna"]">@((MarkupString)LajnaMarkSvg.Small)<span>@L["Ask Lajna"]</span></a>
            <aside id="lajna" class="lajna" role="dialog" aria-modal="false" aria-labelledby="lajnatitle" hidden>
                <header class="ljpanelhead">
                    <span aria-hidden="true">@((MarkupString)LajnaMarkSvg.Large)</span>
                    <div><b id="lajnatitle">@L["Lajna"]</b><span>@L["Anjal's helper"]</span></div>
                    <span class="lh-grow"></span>
                    <a class="iconbtn" href="/lajna?page=@Uri.EscapeDataString(PathNow)" title="@L["Open as a page"]" aria-label="@L["Open as a page"]"><LipiIcon Name="expand" Size="16" /></a>
                    <button type="button" class="iconbtn" data-lajna-close title="@L["Close"]" aria-label="@L["Close"]"><LipiIcon Name="close" Size="16" /></button>
                </header>
                <div class="ljlog" data-lajna-log>
                    <p class="ljhello">@L["Hello {name}. Ask me how to do something in Anjal, to find your mail, or to write a draft. I read only your own mail and settings, here in Anjal, and I never send or change anything without your Yes."].Replace("{name}", MailboxService.FirstName(DisplayName, context.User.Identity?.Name), StringComparison.Ordinal)</p>
                    <p class="ljchips">
                        @foreach (string q in Pages.LajnaPage.Suggestions)
                        {
                            <a href="/lajna?q=@Uri.EscapeDataString(L[q])&page=@Uri.EscapeDataString(PathNow)" data-lajna-q="@L[q]">@L[q]</a>
                        }
                    </p>
                </div>
                <form class="ljform" method="get" action="/lajna" data-lajna-form data-noswap>
                    <input type="hidden" name="page" value="@PathNow" />
                    <input class="inp" name="q" maxlength="300" autocomplete="off" placeholder="@L["Ask Lajna"]" aria-label="@L["Ask Lajna"]" />
                    <button type="submit" class="btn btn-p" title="@L["Ask"]">@L["Ask"]</button>
                </form>
                <p class="ljfine">@L["Lajna works inside Anjal: nothing you ask leaves this server, and nothing is kept."]</p>
            </aside>
            @* The tour's steps: each points at a real button; one missing from the page is skipped. *@
            <div hidden id="tour" data-steps="@TourJson"></div>
            @* The bubble is page markup, like every button (review 3); the script fills it in. *@
            <div class="tourtip" id="tourtip" role="dialog" aria-live="polite" aria-labelledby="tourtitle" hidden>
                <b id="tourtitle" data-tour-title></b>
                <p data-tour-text></p>
                <span class="tourcount" data-tour-count></span>
                <div class="tourbar">
                    <button type="button" class="btn btn-q btn-sm" data-tour-skip>@L["Skip"]</button>
                    <button type="button" class="btn btn-s btn-sm" data-tour-back>@L["Back"]</button>
                    <button type="button" class="btn btn-p btn-sm" data-tour-next data-word-next="@L["Next"]" data-word-done="@L["Done"]">@L["Next"]</button>
                </div>
            </div>
            @* The "?" panel (SPEC-11 item 38, UX-03): the approved board's shortcuts.
               It opens from any "?" link even without the script (:target). *@
            <div id="shortcuts" class="kbpanel" role="dialog" aria-modal="true" aria-labelledby="kbtitle">
                <div class="kbcard">
                    <div class="kbhead">
                        <h2 id="kbtitle">@L["Keyboard shortcuts"]</h2>
                        <a class="linkbtn kbtour" href="/help" title="@L["Read how to do things in Anjal."]">@L["Help guide"]</a>
                        <a class="linkbtn kbtour" href="/dashboard/today#tour">@L["Restart the tour"]</a>
                        <a class="iconbtn" href="#close" aria-label="@L["Close"]" title="@L["Close"]"><LipiIcon Name="close" Size="17" /></a>
                    </div>
                    <div class="kbgrid">
                        @foreach ((string group, (string What, string[] Keys)[] keys) in ShortcutGroups)
                        {
                            <section>
                                <h3>@L[group]</h3>
                                @foreach ((string what, string[] combo) in keys)
                                {
                                    <div class="kbrow"><span>@L[what]</span><span class="kbkeys">@for (int k = 0; k < combo.Length; k++) { @if (k > 0) { <i>@(combo[k - 1] == "g" ? L["then"] : "+")</i> }<kbd>@combo[k]</kbd> }</span></div>
                                }
                            </section>
                        }
                    </div>
                    <p class="hint">@L["Shortcuts work in every language. Press ? anywhere to open this panel."]</p>
                </div>
            </div>
            @* rc.13 (board AuthIdle): a minute before an idle sign-out, this asks. Unsent
               text is saved as a draft first. The script shows it; without the script,
               the server still signs the session out when its time is up. *@
            <div class="idlewrap" data-idle hidden>
                <div class="idlebox" role="alertdialog" aria-modal="true" aria-labelledby="idletitle" aria-describedby="idletext">
                    <h2 id="idletitle"><LipiIcon Name="clock" Size="22" /><span data-idle-title data-word="@L["Signing out in {time}"]">@L["Signing out in {time}"].Replace("{time}", "1:00", StringComparison.Ordinal)</span></h2>
                    <p id="idletext">@(Shared ? L["You have been idle on a shared computer. Your unsent text is saved as a draft, so nothing is lost."] : L["You have been idle for a long time. Your unsent text is saved as a draft, so nothing is lost."])</p>
                    <div class="idlebtns">
                        <button type="button" class="btn btn-p" data-idle-stay>@L["Stay signed in"]</button>
                        <button type="button" class="btn btn-s" data-idle-out>@L["Sign out now"]</button>
                    </div>
                </div>
            </div>
            <form method="post" action="/sign-out" data-idle-form hidden>
                <AntiforgeryToken />
                <input type="hidden" name="reason" value="idle" data-idle-reason />
            </form>
            @* rc.13: another device asks this one to approve a sign-in or a password reset. *@
            <template data-approval-template>
                <div class="approvebar" role="alertdialog" aria-live="assertive">
                    <LipiIcon Name="two-factor" Size="20" />
                    <span class="approvetext" data-approve-text
                          data-word-signin="@L["Someone is signing in to your mailbox on {device} ({address}). Is it you?"]"
                          data-word-reset="@L["Someone asks to reset your password on {device} ({address}). Is it you?"]"></span>
                    <button type="button" class="btn btn-p btn-sm" data-approve="approve">@L["Yes, it is me"]</button>
                    <button type="button" class="btn btn-danger-q btn-sm" data-approve="refuse">@L["No"]</button>
                </div>
            </template>
            <footer class="statusbar" data-statusbar data-me="@mailbox?.Id" data-shared="@(Shared ? "1" : "0")" data-tz="@clock.ZoneId" data-hours="@clock.Hours" data-sound="@((person?.NewMailSound ?? true) ? "1" : "0")" data-notify="@(notifyScope)" data-idle-limit="@((int)SessionRegistry.IdleLimit(Shared).TotalSeconds)"
                    data-word-updated="@L["Updated {time}"]" data-word-offline="@L["Offline: showing mail as of {time}"]"
                    data-word-needs-server="@L["Needs a connection. Try again when you are back online."]"
                    data-word-new="@L["{n} new messages just arrived."]">
                <span class="lite" data-connectivity data-online="@L["Connected"]" data-offline="@L["Offline"]"><i></i><span class="slot" data-slot-a="@L["Connected"]" data-slot-b="@L["Offline"]">@L["Connected"]</span></span>
                <span class="st-sub" data-updated>@L["Updated {time}"].Replace("{time}", clock.Time(now), StringComparison.Ordinal)</span>
                @* Design review 4.5: the status bar keeps the connection and the time it last looked,
                   a storage meter, the draft state while writing, and "? Shortcuts". *@
                <span class="st-grow"></span>
                <span class="st-sub st-draft" data-st-draft hidden></span>
                @if (mailbox is not null)
                {
                    @* DES-11 D2: the storage plan - own size, shared total or reserve; amber from 80%, red when full. *@
                    <span class="st-sub st-store @(Full ? "st-full" : storage?.Percent >= 80 ? "st-warn" : "")" title="@StorageTip">@StorageText<span class="st-meter" aria-hidden="true"><i style="width:@(Math.Min(100, storage?.Percent ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></span></span>
                    <span class="st-sep" aria-hidden="true"></span>
                }
                @* rc.18 screen check: on a computer Lajna opens from here, so no floating button covers the envelope's
                   actions; a phone keeps the floating button. *@
                <a class="st-link st-lajna" href="/lajna?page=@Uri.EscapeDataString(PathNow)" data-lajna-open aria-controls="lajna" title="@L["Ask Lajna"]">@((MarkupString)LajnaMarkSvg.Small)@L["Ask Lajna"]</a>
                <a class="st-link" href="#shortcuts" title="@L["Keyboard shortcuts"]">? @L["Shortcuts"]</a>
            </footer>
            <JsWords L="L" />
            <ButtonTips L="L" Admin="isAdmin" Operator="isOperator" />
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="frame">
            <main class="pane" id="main"><CascadingValue Value="this" IsFixed="true">@Body</CascadingValue></main>
        </div>
    </NotAuthorized>
</AuthorizeView>
}

@code {
    // rc.14: the console a page belongs to, by its path (not a substring: /ops/orgs is not /org).
    private string FrameClass => "frame density-" + (person?.Density ?? MailboxPreferences.DefaultDensity) + (acting is not null ? " acting" : string.Empty);

    private bool OnPath(string root)
    {
        string path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        return path == root || path.StartsWith(root + "/", StringComparison.OrdinalIgnoreCase);
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private IReadOnlyList<FolderView>? folders;
    private MailboxRow? mailbox;
    private Lexicon L = new("en", new Dictionary<string, string>());
    private ZonedClock clock = ZonedClock.Default;
    private DateTimeOffset now = DateTimeOffset.UtcNow;

    private bool Folded => person?.RailFolded ?? false;

    // rc.15: the boards draw the rail as icons on a laptop; until the person folds or opens it, it does so by itself.
    private bool RailAuto => !(person?.RailChosen ?? false);

    private MailboxRow? person;
    private string? signInDemand;

    // DES-11 D5: the offline pages the worker draws speak the person's language too.
    private string OfflineWords => System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["You are offline. Your mail list on this device is locked."] = L["You are offline. Your mail list on this device is locked."],
        ["Offline code"] = L["Offline code"],
        ["Open the list"] = L["Open the list"],
        ["Use my passkey"] = L["Use my passkey"],
        ["Five wrong tries remove the list from this device."] = L["Five wrong tries remove the list from this device."],
        ["You are offline."] = L["You are offline."],
        ["No mail list is kept on this device. Anjal opens when it can be reached again."] = L["No mail list is kept on this device. Anjal opens when it can be reached again."],
        ["The mail list on this device was removed: it had not reached Anjal for seven days. It is kept again once Anjal can be reached."] = L["The mail list on this device was removed: it had not reached Anjal for seven days. It is kept again once Anjal can be reached."],
        ["This mail opens when Anjal can be reached again. Only the list is kept on this device."] = L["This mail opens when Anjal can be reached again. Only the list is kept on this device."],
        ["Back to the list"] = L["Back to the list"],
        ["You are offline. This is the list kept on this device at {time}. Mail opens when Anjal can be reached again."] = L["You are offline. This is the list kept on this device at {time}. Mail opens when Anjal can be reached again."],
        ["Inbox"] = L["Inbox"],
        ["Sent"] = L["Sent"],
        ["Nothing kept."] = L["Nothing kept."],
        ["The mail list was removed from this device after five wrong tries. It is kept again, under a new offline code, once Anjal can be reached."] = L["The mail list was removed from this device after five wrong tries. It is kept again, under a new offline code, once Anjal can be reached."],
        ["That code is not right."] = L["That code is not right."],
    });
    private StorageState? storage;
    private SignInMark? lastSignIn;

    // DES-11 S5: "Last sign-in: 09:12, Pune, India" - the sign-in before this one, so a stranger's shows.
    private string LastSignInText => lastSignIn is null ? string.Empty
        : L["Last sign-in: {when}{place}"].Replace("{when}", clock.Local(lastSignIn.At).Date == clock.Local(DateTimeOffset.UtcNow).Date ? clock.Time(lastSignIn.At) : clock.Time(lastSignIn.At) + ", " + clock.Date(lastSignIn.At), StringComparison.Ordinal)
            .Replace("{place}", lastSignIn.Place.Length > 0 ? ", " + lastSignIn.Place : string.Empty, StringComparison.Ordinal);
    private MailboxRow? acting;
    private string actingRight = "read";
    private bool isAdmin;
    private bool isOperator;
    private bool offlineMail;
    private IReadOnlyList<(MailboxRow Box, string Right, long Unread)> sharedBoxes = System.Array.Empty<(MailboxRow, string, long)>();

    private static string RightWord(string right) => right switch { "manage" => "manage rights", "send" => "read and send rights", _ => "read-only rights" };

    private bool shared;

    private string PathNow => "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    // DES-11 S4: "Confirm it is you" stands alone like the sign-in pages.
    private bool AuthPage => PathNow is "/sign-in" or "/login" or "/signed-out" or "/settings/security/confirm" or "/terms" or "/terms/accept" or "/disclaimer"
        || PathNow.StartsWith("/sign-in/", StringComparison.Ordinal) || PathNow.StartsWith("/invite/", StringComparison.Ordinal) || PathNow.StartsWith("/join/", StringComparison.Ordinal);

    private bool OnTwoStepSetup => PathNow.StartsWith("/settings/security/two-step", StringComparison.Ordinal);

    /// <summary>True when signed in on a shared computer (rc.13).</summary>
    private bool Shared => shared;

    /// <summary>What is different about Anjal: the welcome screen's cards (D-105).</summary>
    private static readonly (string Icon, string Title, string Text)[] WelcomeCards =
    {
        ("home", "Today", "Anjal opens on Today: your unread mail, with what needs you first and why."),
        ("security", "Stamps", "Green stamps on the envelope show what Anjal has proved: a verified sender, mail that arrived encrypted, an original kept unchanged."),
        ("lock", "Patient mail stays safe", "Mail is encrypted both ways and every original is kept as proof. Your organisation decides who may write outside."),
    };

    /// <summary>The tour's steps (item 5): where each points, and what it says.</summary>
    private string TourJson => System.Text.Json.JsonSerializer.Serialize(new[]
    {
        // rc.16 and rc.18, design review [6j]: four steps - Today, the envelope (or the list, where no
        // letter is open), Compose, and Lajna.
        new { at = ".rail a[href='/dashboard/today']", title = L["Today"], text = L["Your unread mail, what needs you first, and why. Anjal opens here."] },
        new { at = ".eaddress, .tdunread, .mlist", title = L["The envelope"], text = L["Who it is from and to, with the stamps: what Anjal has proved about each message."] },
        new { at = ".rail-compose", title = L["Compose"], text = L["Write a new message."] },
        new { at = ".st-lajna, .lajnabtn", title = L["Lajna"], text = L["Ask Lajna how to do something, to find your mail, or to write a draft. It works inside Anjal and never sends anything."] },
    });

    /// <summary>The approved shortcuts board, group by group (item 38).</summary>
    private static readonly (string Group, (string What, string[] Keys)[] Keys)[] ShortcutGroups =
    {
        ("Move around", new[] { ("Next / previous message", new[] { "j", "k" }), ("Open", new[] { "Enter" }), ("Back, or leave focus", new[] { "Esc" }), ("Go to Inbox", new[] { "g", "i" }), ("Search", new[] { "/" }) }),
        ("Act on mail", new[] { ("Reply", new[] { "r" }), ("Reply all", new[] { "a" }), ("Forward", new[] { "f" }), ("Archive", new[] { "e" }), ("Delete", new[] { "#" }), ("Flag", new[] { "s" }) }),
        ("Select", new[] { ("Tick a message", new[] { "x" }), ("Tick a range", new[] { "Shift", "click" }), ("Tick all on the page", new[] { "Ctrl", "A" }) }),
        ("Compose", new[] { ("Compose", new[] { "c" }), ("Send", new[] { "Ctrl", "Enter" }), ("Undo", new[] { "Ctrl", "Z" }) }),
        ("Layout", new[] { ("Focus", new[] { "Shift", "F" }), ("Fold or open the rail", new[] { "[" }), ("This panel", new[] { "?" }) }),
    };

    private string DisplayName => person is null || person.DisplayName.Length == 0 ? string.Empty : person.DisplayName;

    /// <summary>The person's initials for the phone's top bar (the board's "AS"); the address's first letter when there is no name.</summary>
    private string Initials
    {
        get
        {
            string[] parts = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0)
            {
                string address = person?.Address ?? "?";
                return address.Length > 0 ? address[..1].ToUpperInvariant() : "?";
            }
            string first = parts[0][..1];
            string last = parts.Length > 1 ? parts[^1][..1] : string.Empty;
            return (first + last).ToUpperInvariant();
        }
    }

    /// <summary>The page to come back to after folding the rail.</summary>
    private string BackPath => "/" + Nav.ToBaseRelativePath(Nav.Uri);


    private bool Full => storage?.Full == true;

    private int UsagePercent => storage?.Percent ?? 0;

    private string StorageText => storage is null || mailbox is null ? string.Empty
        : storage.Plan == "shared" && storage.OwnLimit == 0
            ? L["{used}; shared {sharedUsed} of {shared}"].Replace("{used}", Size(storage.Used), StringComparison.Ordinal).Replace("{sharedUsed}", Size(storage.SharedUsed), StringComparison.Ordinal).Replace("{shared}", Size(storage.Shared), StringComparison.Ordinal)
        : storage.Plan == "mixed" && storage.OwnLimit > 0 && storage.Used >= storage.OwnLimit && !storage.Full
            ? L["{used} of {quota}, drawing on the shared reserve"].Replace("{used}", Size(storage.Used), StringComparison.Ordinal).Replace("{quota}", Size(storage.OwnLimit), StringComparison.Ordinal)
            : L["{used} of {quota}"].Replace("{used}", Size(storage.Used), StringComparison.Ordinal).Replace("{quota}", QuotaText, StringComparison.Ordinal);

    private string StorageTip => storage is null ? string.Empty
        : storage.Full ? L["Your mailbox is full: nothing more arrives, and you cannot send. Delete or archive some mail."]
        : storage.Percent >= 80 ? L["{p}% full. Delete or archive some mail before it fills."].Replace("{p}", storage.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal)
        : string.Empty;

    private string QuotaText => storage is null || storage.OwnLimit <= 0 ? L["no limit"] : Size(storage.OwnLimit);

    /// <summary>INBOX shows unread (what needs attention); every other folder shows its total.</summary>
    private static string? Badge(FolderView f)
    {
        if (f.Name == FolderRow.Inbox)
        {
            return f.Unread > 0 ? f.Unread.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
        }
        return f.Count > 0 ? f.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) : null;
    }

    private static string IconFor(string folder) => folder switch
    {
        "Sent" => "referral-out",
        "Drafts" => "draft",
        "Junk" => "compliance-shield",
        "Trash" => "trash",
        "Archive" => "archive",
        "Scheduled" => "scheduled",
        "Snoozed" => "clock",
        "Outbox" => "referral-out",
        FolderRow.Inbox => "email",
        _ => "folder",
    };

    /// <summary>
    /// When a message arrived, as short as it can be while still clear: the
    /// time today, "Yesterday", the weekday this week, the day and month this
    /// year, the full date otherwise - all decided in the person's own time
    /// zone (DEF-088). Shared by every list so they agree.
    /// </summary>
    internal static string When(DateTimeOffset at, ZonedClock clock) => clock.List(at, DateTimeOffset.UtcNow);

    // Owner, 9 Oct 2026: every size is written one way, with two decimals (Services/Sizes.cs).
    internal static string Size(long bytes) => Sizes.Text(bytes);

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
        {
            return;
        }
        AuthenticationState state = await AuthState;
        L = Words.For(WebmailAuthService.LanguageOf(state.User, Words));
        clock = WebmailAuthService.ClockOf(state.User);
        shared = SessionRegistry.IsShared(state.User);
        now = DateTimeOffset.UtcNow;
        Guid? mailboxId = WebmailAuthService.MailboxIdOf(state.User);
        if (mailboxId is null)
        {
            return;
        }
        this.currentMailbox ??= mailboxId;
        await this.LoadFoldersAsync(mailboxId.Value);
        mailbox = (await Mail.GetContextAsync(mailboxId.Value))?.Mailbox;
        storage = mailbox is null ? null : await Mail.StorageStateAsync(mailbox);
        Guid? personId = WebmailAuthService.PersonIdOf(state.User);
        person = personId == mailboxId ? mailbox : personId is Guid pid ? (await Mail.GetContextAsync(pid))?.Mailbox : null;
        if (personId is Guid me)
        {
            sharedBoxes = await Mail.SharedForPersonAsync(me);
            isAdmin = await Mail.IsOrgAdminAsync(me);
            lastSignIn = (await Mail.GetSecurityAsync(me)).PreviousSignIn;
            signInDemand = await Mail.SignInDemandCachedAsync(me);
            isOperator = Operators.Is(person?.Address);
            offlineMail = (await Mail.OfflineMailAsync(me, shared)).On;
            MailSettings ms = await Mail.GetMailSettingsAsync(me);
            notifyScope = ms.DesktopNotify && !shared ? ms.NotifyScope : string.Empty;
            if (!shared && Http.HttpContext is { } ctx)
            {
                otherAccounts = await Mail.OtherAccountsAsync(AuthEndpoints.ReadAccounts(ctx).Where(a => a.Mailbox != me).Select(a => a.Mailbox).ToList());
            }
            if (WebmailAuthService.ActingOf(state.User) is Guid open && sharedBoxes.FirstOrDefault(b => b.Box.Id == open) is { Box: not null } found)
            {
                acting = found.Box;
                actingRight = found.Right;
            }
        }
    }

    private int outboxCount;
    private IReadOnlyList<(MailboxRow Mailbox, long Unread)> otherAccounts = Array.Empty<(MailboxRow, long)>();
    private string notifyScope = string.Empty;

    private static string InitialsOf(MailboxRow m)
    {
        string name = m.DisplayName.Trim().Length > 0 ? m.DisplayName.Trim() : m.LocalPart;
        string[] parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? (char.ToUpperInvariant(parts[0][0]).ToString() + char.ToUpperInvariant(parts[^1][0])) : name.Length > 0 ? char.ToUpperInvariant(name[0]).ToString() : "?";
    }

    private bool OnOutbox => Nav.Uri.Contains("/outbox", StringComparison.OrdinalIgnoreCase);

    private Guid? currentMailbox;
    private int foldersGeneration;

    /// <summary>
    /// Reload the folder counts (v1.0.0-rc.9, DEF-066, D-56): the message page
    /// calls this right after marking a message read, so the INBOX count on that
    /// same page is already lower.
    /// </summary>
    /// <param name="mailboxId">The signed-in mailbox.</param>
    /// <returns>A task.</returns>
    public async Task RefreshFoldersAsync(Guid mailboxId)
    {
        this.currentMailbox ??= mailboxId;
        await this.LoadFoldersAsync(mailboxId);
        StateHasChanged();
    }

    // The first load and a refresh run concurrently; only the newest may land,
    // so a slow first query cannot overwrite the fresh count with a stale one.
    private async Task LoadFoldersAsync(Guid mailboxId)
    {
        int mine = System.Threading.Interlocked.Increment(ref this.foldersGeneration);
        IReadOnlyList<FolderView> result = await Mail.ListFoldersAsync(mailboxId);
        int waiting = await Mail.CountOutboxAsync(mailboxId);
        if (mine == System.Threading.Volatile.Read(ref this.foldersGeneration))
        {
            folders = result;
            outboxCount = waiting;
        }
    }

    private bool IsCurrent(string folderName)
    {
        string path = Nav.ToBaseRelativePath(Nav.Uri);
        if (folderName == FolderRow.Inbox && (path.Length == 0 || path.StartsWith("?", StringComparison.Ordinal)))
        {
            return true;
        }
        return path.StartsWith("folder/" + Uri.EscapeDataString(folderName), StringComparison.Ordinal);
    }
}
