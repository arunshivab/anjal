@inject Microsoft.AspNetCore.Http.IHttpContextAccessor Http
<!DOCTYPE html>
<html lang="en" data-theme="@Anjal.Webmail.Services.WebmailAuthService.ThemeOf(Http.HttpContext?.User)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    <link rel="icon" href="/logos/anjal-favicon.svg" type="image/svg+xml" />
    @* Each link carries a fingerprint of the file's contents, so an upgrade
       reaches every browser at once instead of an hour later (DEF-033). *@
    <link rel="stylesheet" href="/tokens.css?v=@StaticAssets.Fingerprint("tokens.css")" />
    <link rel="stylesheet" href="/app.css?v=@StaticAssets.Fingerprint("app.css")" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="/app.js?v=@StaticAssets.Fingerprint("app.js")" defer></script>
</body>
</html>
