<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Anjal.Acme\Anjal.Acme.csproj" />
    <ProjectReference Include="..\Anjal.Mailbox\Anjal.Mailbox.csproj" />
    <ProjectReference Include="..\Anjal.Mime\Anjal.Mime.csproj" />
    <ProjectReference Include="..\Anjal.Smtp\Anjal.Smtp.csproj" />
    <ProjectReference Include="..\Anjal.Spam\Anjal.Spam.csproj" />
    <ProjectReference Include="..\Anjal.Store\Anjal.Store.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stylesheet is embedded and served from an endpoint so the UI
         is self-contained wherever the host is launched from. -->
    <Content Remove="wwwroot\app.css" />
    <EmbeddedResource Include="wwwroot\app.css" LogicalName="Anjal.Webmail.app.css" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Razor-generated component classes have no XML docs; keep the UI host out of docs/api. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

</Project>
