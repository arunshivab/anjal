<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Anjal.Acme\Anjal.Acme.csproj" />
    <ProjectReference Include="..\Anjal.Mailbox\Anjal.Mailbox.csproj" />
    <ProjectReference Include="..\Anjal.Mime\Anjal.Mime.csproj" />
    <ProjectReference Include="..\Anjal.Smtp\Anjal.Smtp.csproj" />
    <ProjectReference Include="..\Anjal.Spam\Anjal.Spam.csproj" />
    <ProjectReference Include="..\Anjal.Store\Anjal.Store.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiPicons.Blazor" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static assets are embedded and served from endpoints so the UI is
         self-contained wherever the host is launched from: no wwwroot on disk,
         no third-party request, and nothing to copy at deploy time. -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Razor-generated component classes have no XML docs; keep the UI host out of docs/api. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

</Project>
