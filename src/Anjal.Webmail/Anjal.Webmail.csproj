<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Anjal.Acme\Anjal.Acme.csproj" />
    <ProjectReference Include="..\Anjal.Imap\Anjal.Imap.csproj" />
    <ProjectReference Include="..\Anjal.Mailbox\Anjal.Mailbox.csproj" />
    <ProjectReference Include="..\Anjal.Mime\Anjal.Mime.csproj" />
    <ProjectReference Include="..\Anjal.Smtp\Anjal.Smtp.csproj" />
    <ProjectReference Include="..\Anjal.Spam\Anjal.Spam.csproj" />
    <ProjectReference Include="..\Anjal.Store\Anjal.Store.csproj" />
    <ProjectReference Include="..\Anjal.Viewing\Anjal.Viewing.csproj" />
    <!-- rc.29 (DES-22 §11): built with the webmail so a developer's run finds it, but never referenced - the
         webmail speaks to the viewer over its socket and carries none of the file libraries. -->
    <ProjectReference Include="..\Anjal.Viewer\Anjal.Viewer.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- D-405, D-406: the tests turn the PDF editor's held-back parts on to check what they guard. -->
    <InternalsVisibleTo Include="Anjal.Webmail.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiPicons.Blazor" Version="1.1.0" />
    <!-- D-405 (the owner, 18 Nov 2026): a mail import's ZIP is read with Chuvadi.Zip's untrusted limits, lowered. -->
    <PackageReference Include="Chuvadi.Zip" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Static assets are embedded and served from endpoints so the UI is
         self-contained wherever the host is launched from: no wwwroot on disk,
         no third-party request, and nothing to copy at deploy time. -->
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="Resources\Words\*.json" />
    <EmbeddedResource Include="Resources\Help\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Razor-generated component classes have no XML docs; keep the UI host out of docs/api. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

</Project>
