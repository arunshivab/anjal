# Build output
bin/
obj/
[Bb]uild/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio
.vs/
*.rsuser

# JetBrains Rider
.idea/
*.DotSettings.user

# VS Code
.vscode/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
[Cc]overlet/

# NuGet
*.nupkg
# ...except imagiQa's own packages, which are restored from the repo's
# local feed so a clone builds with no external package source.
!localpackages/*.nupkg
*.snupkg
.nuget/
packages/

# Python (for tools/gen_api_docs.py)
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs and local artifacts
*.log
*.local.json
secrets.json

# Release tarballs built by deploy/publish.ps1. Large, reproducible from a
# tag, and never committed: keeping them out also stops a stray "git add -A"
# from pulling ~200 MB of publish output into the history.
artifacts/

# Secrets: never commit keys, certificates or environment files (SEC-R3).
*.pem
*.key
*.pfx
*.p12
.env
*.env
!deploy/server.env.example
